# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://localhost:1025
MAILER_FROM=noreply@aurora.local
ADMIN_EMAIL=admin@aurora.local
###< symfony/mailer ###

###> aurora/mount-point ###
AURORA_MOUNT_POINT_KEY=replace_with_base64_32_bytes_key
###< aurora/mount-point ###

###> aurora/encryption ###
# Used by Aurora's generic encryption service (EncryptionService + Doctrine
# encrypted_text / encrypted_string types). Must be a base64-encoded 32-byte
# key. Generate one with: php -r "echo base64_encode(random_bytes(32));"
AURORA_ENCRYPTION_KEY=replace_with_base64_32_bytes_key
###< aurora/encryption ###

###> symfony/resend-mailer ###
# MAILER_DSN=resend+api://API_KEY@default
# MAILER_DSN=resend+smtp://resend:API_KEY@default
###< symfony/resend-mailer ###

###> aurora/storage-r2 ###
# Cloudflare R2, off unless all four are filled. Credentials never belong in
# this file: it is committed and the repository is public. Put them in
# .env.local (ignored by git), or in the server's environment.
#
# From the Cloudflare dashboard: R2 > Manage API tokens > Create API token,
# with "Object Read & Write" scoped to the single bucket. The endpoint is the
# account URL WITHOUT the bucket at the end; the bucket goes in R2_BUCKET.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public hostname mapped onto the bucket, when there is one. Without it the
# adapter has no public URL to offer and callers fall back to a presigned one.
R2_PUBLIC_BASE_URL=
###< aurora/storage-r2 ###

###> aurora/mercure ###
# Le hub temps réel des discussions d'espace client. Vide = pas de hub : les
# messages sont stockés et postés normalement, ils arrivent au rechargement.
#
# Sous un marqueur aurora/ plutôt que symfony/, parce que c'est ce que
# `sync-client-env` recopie : un bloc nommé d'après le paquet Flex n'aurait
# jamais atteint les projets qui consomment la librairie, et ces variables
# sont précisément ce qu'ils doivent renseigner pour allumer le direct.
#
# MERCURE_URL est l'adresse que PHP utilise pour publier (boucle locale),
# MERCURE_PUBLIC_URL celle que le navigateur ouvre (hôte public). Le hub doit
# épingler son resource_identifier sur cette dernière, et reconnaître
# MERCURE_ISSUER comme émetteur de confiance.
MERCURE_URL=
MERCURE_PUBLIC_URL=
MERCURE_JWT_SECRET=
MERCURE_ISSUER=
###< aurora/mercure ###
