{% extends '@Core/suite/layout.html.twig' %}

{% block title %}{{ 'suite.nav.administration'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {% set tabLabels = {
        overview: 'suite.tabs.overview'|trans,
        users: 'suite.tabs.users'|trans,
        access_requests: 'suite.tabs.access_requests'|trans,
        audit: 'suite.tabs.audit'|trans,
        permissions: 'suite.tabs.permissions'|trans,
        modules: 'suite.tabs.modules'|trans,
        mount_points: 'suite.tabs.mount_points'|trans,
    } %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'suite.nav.sections.dev'|trans},
            {label: 'suite.nav.administration'|trans, href: path('dev_dashboard')},
            {label: tabLabels[tab] ?? tab},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('dev/suite/AdministrationApp', {
    tab: tab,
    stats: tab == 'overview' ? stats : {},
    enabledModules: tab == 'overview' ? enabledModules|default({}) : {},
    users: tab == 'users' ? users : {},
    accessRequests: tab == 'access_requests' ? accessRequests : {},
    audit: tab == 'audit' ? audit : {},
    permissions: tab == 'permissions' ? permissions : {},
    modules: tab == 'modules' ? modules : {},
    mountPoints: tab == 'mount_points' ? mountPoints : {},
    search: search ?? '',
    group: group ?? '',
    overviewPath: path('dev_dashboard'),
    usersPath: path('dev_users'),
    userCreatePath: path('dev_users_create'),
    userUpdatePath: path_template('dev_users_update', {id: '__id__'}),
    userToggleRolePath: path_template('dev_users_toggle_role', {id: '__id__'}),
    userDeletePath: path_template('dev_users_delete', {id: '__id__'}),
    accessRequestsPath: path('dev_access_requests'),
    accessRequestApprovePath: path_template('dev_access_requests_approve', {id: '__id__'}),
    accessRequestRejectPath: path_template('dev_access_requests_reject', {id: '__id__'}),
    accessRequestPurgePath: path('dev_access_requests_purge'),
    auditPath: path('dev_audit'),
    permissionsPath: path('dev_permissions'),
    modulesPath: path('dev_modules'),
    moduleUpdatePath: path_template('dev_modules_update', {key: '__key__'}),
    moduleVerifyPasswordPath: path('dev_modules_verify_password'),
    mountPointsPath: path('dev_mount_points'),
    mountPointCreatePath: path('dev_mount_points_create'),
    mountPointUpdatePath: path_template('dev_mount_points_update', {id: '__id__'}),
    mountPointDeletePath: path_template('dev_mount_points_delete', {id: '__id__'}),
    mountPointTestPath: path_template('dev_mount_points_test', {id: '__id__'}),
    impersonatePath: path_template('suite_dashboard', {_switch_user: '__email__'}),
    csrfToken: csrf_token('admin'),
    healthPath: path('dev_dashboard_health'),
    healthRetryPath: path_template('dev_dashboard_health_failed_retry', {id: '__id__'}),
    healthDeletePath: path_template('dev_dashboard_health_failed_delete', {id: '__id__'}),
}) }} class="flex-1"></div>
{% endblock %}
