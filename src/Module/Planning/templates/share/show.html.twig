{% extends '@Planning/share/layout.html.twig' %}

{% block title %}{{ label }} - {{ siteName }}{% endblock %}

{% block heading %}{{ label }}{% endblock %}

{% block subheading %}
    {{ 'frontend.plannings.share.read_only'|trans }}
    {% if expiresAt %} &middot; {{ 'frontend.plannings.share.until'|trans({'%date%': expiresAt|site_datetime}) }}{% endif %}
{% endblock %}

{% block body %}
<div {{ vue_component('planning/suite/share/PlanningShareApp', {
    calendars: calendars,
    zone: zone,
    eventsPath: path('planning_share_events', {token: token}),
}) }} class="min-w-0 flex-1"></div>
{% endblock %}
