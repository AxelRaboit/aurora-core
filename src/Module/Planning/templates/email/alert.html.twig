{% extends '@Shared/email/layout/base.html.twig' %}

{% block content %}
<h1>{{ title }}</h1>
<p>{{ 'backend.plannings.mail.alert_intro'|trans({'%calendar%': calendarName}) }}</p>

<table class="panel" role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
    <tr>
        <td class="panel-content">
            <p style="margin:0 0 6px;">
                <strong>{{ 'backend.plannings.events.starts'|trans }} :</strong> {{ whenText }}
            </p>
            {% if location %}
                <p style="margin:0 0 6px;">
                    <strong>{{ 'backend.plannings.events.location'|trans }} :</strong> {{ location }}
                </p>
            {% endif %}
            {% if description %}
                <p style="margin:0;"><em>{{ description|nl2br }}</em></p>
            {% endif %}
        </td>
    </tr>
</table>

{% if url %}
    <p><a href="{{ url }}">{{ 'backend.plannings.mail.open'|trans }}</a></p>
{% endif %}
{% endblock %}
