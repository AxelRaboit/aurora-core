{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ 'backend.nav.planning'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.planning'|trans},
            {label: 'backend.nav.planning'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
{# The month view arrives at step 3. Until then this page proves the route, the
   privilege gate and the calendar payload, which is what step 2 is for: the API
   is testable before there is anything to look at. #}
<div class="bg-surface border border-line rounded-xl p-5 space-y-3">
    <h2 class="text-sm font-semibold text-primary">{{ 'backend.plannings.calendars'|trans }}</h2>

    {% if calendars is empty %}
        <p class="text-sm text-muted">{{ 'backend.plannings.empty'|trans }}</p>
    {% else %}
        <ul class="flex flex-col gap-1.5 text-sm">
            {% for calendar in calendars %}
                <li class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded shrink-0" style="background: var(--chart-cat-{{ calendar.colourSlot }})"></span>
                    <span class="text-secondary">{{ calendar.name }}</span>
                    <span class="ml-auto text-xs text-muted tabular-nums">{{ calendar.eventCount }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
{% endblock %}
