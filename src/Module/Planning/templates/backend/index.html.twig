{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ 'backend.nav.planning'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.planning'|trans},
            {label: 'backend.nav.planning'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('planning/backend/planning/PlanningApp', {
    calendars: calendars,
    timezones: timezones,
    eventsPath: path('backend_planning_events'),
    createCalendarPath: path('backend_planning_calendars_create'),
    updateCalendarPathTemplate: path_template('backend_planning_calendars_update', {id: '__id__'}),
    deleteCalendarPathTemplate: path_template('backend_planning_calendars_delete', {id: '__id__'}),
    createEventPath: path('backend_planning_events_create'),
    createReminderPath: path('backend_planning_reminders_create'),
    updateReminderPathTemplate: path_template('backend_planning_reminders_update', {id: '__id__'}),
    deleteReminderPathTemplate: path_template('backend_planning_reminders_delete', {id: '__id__'}),
    toggleReminderPathTemplate: path_template('backend_planning_reminders_toggle', {id: '__id__'}),
    updateEventPathTemplate: path_template('backend_planning_events_update', {id: '__id__'}),
    deleteEventPathTemplate: path_template('backend_planning_events_delete', {id: '__id__'}),
}) }}></div>
{% endblock %}
