{% extends '@Notes/share/layout.html.twig' %}

{% block title %}{{ note.title|default('')|trim ?: 'notes.markdown.untitled'|trans }} - {{ siteName }}{% endblock %}

{% block heading %}{{ 'notes.markdown.share.page_heading'|trans }}{% endblock %}
{# A writing link says so in the header: "read only" on a page that saves
   would be the one lie the share page must not tell. #}
{% block subheading %}{{ (coediting ? 'notes.markdown.share.coediting_heading' : (canWrite ? 'notes.markdown.share.can_write' : 'notes.markdown.share.read_only'))|trans }}{% endblock %}

{% block body %}
<div {{ vue_component('notes/share/NoteShareApp', {
    imagePrefix: imagePrefix,
    shareImagePath: shareImagePath,
    shareNotePath: shareNotePath,
    noteId: note.id,
    noteTitle: note.title,
    content: note.content,
    cover: cover,
    appearance: appearance,
    tree: tree,
    titleIndex: titleIndex,
    canWrite: canWrite,
    saveNotePath: saveNotePath,
    noteVersion: noteVersion,
    coediting: coediting,
    liveBeatPath: liveBeatPath,
}) }}></div>
{% endblock %}
