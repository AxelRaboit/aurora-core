{# A page for somebody with no account.

   Its own layout rather than the suite's: there is no side menu to put a
   guest in, and no sign-in card to wrap them in either. The head is the same on
   purpose - the theme, the accent colour and the asset tags are what make this
   read as the application rather than a stray page. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {# Nothing here is meant to be found. A share link is a secret handed to
           one person, and a search engine that indexed it would hand it to
           everybody, permanently and beyond any revocation. #}
        <meta name="robots" content="noindex, nofollow, noarchive">
        <meta name="generator" content="Aurora by axelraboit">
        <title>{% block title %}{{ siteName }}{% endblock %}</title>
        {% if siteFaviconUrl %}
            <link rel="icon" href="{{ siteFaviconUrl }}">
        {% else %}
            <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        {% endif %}
        {{ include('@Shared/components/theme_script.html.twig', {colorScheme: true}) }}
        {{ vite_entry_link_tags('app') }}
        {{ include('@Shared/components/primary_color_style.html.twig') }}
        {{ vite_entry_script_tags('app') }}
        {{ vite_entry_script_tags('theme') }}
    </head>
    <body class="min-h-screen bg-body transition-colors duration-200">
        {# A centred column, and a button to take the whole window
           (09/10/2026): a link that writes shows the source and its preview
           side by side, which 1024 pixels leave cramped - but reading reads
           better in a column, so the column stays the default. The choice is
           the reader's, kept by their browser (assets/theme.js). #}
        <div data-widenable {% block widenable_attributes %}{% endblock %} class="mx-auto flex min-h-screen w-full max-w-5xl flex-col gap-4 px-2 py-2 sm:p-6 data-[wide=true]:max-w-none lg:data-[wide=true]:px-8">
            <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1 print:hidden">
                {# The page's fold button for the side column, placed here by the
                   note's component: the bar is where such a button is looked for. #}
                <span data-share-header-start class="inline-flex self-center empty:hidden"></span>
                <h1 class="text-lg font-semibold text-primary">{% block heading %}{% endblock %}</h1>
                <p class="text-xs text-muted">{% block subheading %}{% endblock %}</p>
                <span class="ml-auto inline-flex items-center gap-2 self-center">
                    {{ include('@Shared/components/width_toggle.html.twig') }}
                    {{ include('@Shared/components/theme_toggle.html.twig') }}
                </span>
            </header>

            {% block body %}{% endblock %}

            {# Says where this came from, because a page with no navigation and no
               account gives a reader nothing else to place it by. #}
            <footer class="mt-auto pt-2 text-center text-2xs text-muted">{{ siteName }}</footer>
        </div>
    </body>
</html>
