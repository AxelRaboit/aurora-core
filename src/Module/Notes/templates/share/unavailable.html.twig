{% extends '@Notes/share/layout.html.twig' %}

{% block title %}{{ 'notes.markdown.share.unavailable_title'|trans }} - {{ siteName }}{% endblock %}

{% block heading %}{{ 'notes.markdown.share.unavailable_title'|trans }}{% endblock %}

{% block body %}
    {# One page for every way of failing. An address that never existed, one that
       expired and one that was revoked say the same thing here, because telling
       them apart tells a stranger which of their guesses was close. #}
    <div class="rounded-xl border border-line bg-surface p-6">
        <p class="text-secondary">{{ 'notes.markdown.share.unavailable_body'|trans }}</p>
    </div>
{% endblock %}
