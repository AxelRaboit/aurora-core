{#
   Le lecteur : le carnet se lit, dans un espace à lui.

   Ni menu du back-office, ni barre du haut, ni fil de pages : ce qui reste,
   c'est l'arborescence à gauche et le texte. C'est ce que demande la lecture,
   et c'est pour cela que la page ne prolonge pas le gabarit du back-office.
   La tête est celle de l'application - thème, couleur, assets - pour que la
   page se lise comme Aurora et pas comme une page égarée.
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="noindex, nofollow, noarchive">
        <meta name="generator" content="Aurora by axelraboit">
        <title>{{ note.title|default('')|trim ?: 'notes.markdown.untitled'|trans }} - {{ siteName }}</title>
        {% if siteFaviconUrl %}
            <link rel="icon" href="{{ siteFaviconUrl }}">
        {% else %}
            <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        {% endif %}
        {{ include('@Shared/components/theme_script.html.twig', {colorScheme: true}) }}
        {{ vite_entry_link_tags('app') }}
        {{ include('@Shared/components/primary_color_style.html.twig') }}
        {{ vite_entry_script_tags('app') }}
        {{ vite_entry_script_tags('theme') }}
    </head>
    <body class="min-h-screen bg-body transition-colors duration-200">
        <div {{ vue_component('notes/backend/markdown/NoteReadApp', {
            noteId: note.id,
            noteTitle: note.title,
            content: note.content,
            cover: cover,
            appearance: appearance,
            titleIndex: titleIndex,
            readNotePath: readNotePath,
            imagePrefix: imagePrefix,
            noteImagePath: noteImagePath,
            breadcrumb: breadcrumb,
            canEdit: canEdit,
            backPath: backPath,
            previous: previous,
            next: next,
            libraryPath: libraryPath,
            folderShowPath: folderShowPath,
            treeFolders: treeFolders,
            treeNotes: treeNotes,
            sharedFolders: sharedFolders,
            sharedNotes: sharedNotes,
        }) }}></div>
    </body>
</html>
