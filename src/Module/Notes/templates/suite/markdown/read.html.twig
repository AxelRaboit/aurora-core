{#
   The reader: the notebook is read, in a space of its own.

   No back office menu, no top bar, no breadcrumb: what is left is the tree
   on the left and the text. That is what reading asks for, and that is why
   the page does not extend the back office's layout. The head is the
   application's - theme, colour, assets - so that the page reads as Aurora
   and not as a stray page.
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="noindex, nofollow, noarchive">
        <meta name="generator" content="Aurora by axelraboit">
        <title>{{ note.title|default('')|trim ?: 'notes.markdown.untitled'|trans }} - {{ siteName }}</title>
        {% if siteFaviconUrl %}
            <link rel="icon" href="{{ siteFaviconUrl }}">
        {% else %}
            <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        {% endif %}
        {{ include('@Shared/components/theme_script.html.twig', {colorScheme: true}) }}
        {{ vite_entry_link_tags('app') }}
        {{ include('@Shared/components/primary_color_style.html.twig') }}
        {{ vite_entry_script_tags('app') }}
        {{ vite_entry_script_tags('theme') }}
    </head>
    <body class="min-h-screen bg-body transition-colors duration-200">
        <div {{ vue_component('notes/suite/markdown/NoteReadApp', {
            noteId: note.id,
            noteTitle: note.title,
            content: note.content,
            cover: cover,
            appearance: appearance,
            titleIndex: titleIndex,
            readNotePath: readNotePath,
            imagePrefix: imagePrefix,
            noteImagePath: noteImagePath,
            breadcrumb: breadcrumb,
            canEdit: canEdit,
            favorited: favorited,
            favoritePath: favoritePath,
            backPath: backPath,
            exportPath: exportPath,
            previous: previous,
            next: next,
            libraryPath: libraryPath,
            folderShowPath: folderShowPath,
            treeFolders: treeFolders,
            treeNotes: treeNotes,
            treeSpaces: treeSpaces,
            searchPath: searchPath,
            autoPrint: app.request.query.getBoolean('print'),
        }) }}></div>
    </body>
</html>
