{% extends '@Core/suite/layout.html.twig' %}

{% block title %}{{ 'notes.markdown.title'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'suite.nav.sections.notes'|trans},
            {label: 'notes.markdown.title'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('notes/suite/markdown/MarkdownNotesApp', {
    notes: notes,
    folders: folders,
    folderId: folderId,
    breadcrumb: breadcrumb,
    folderPaths: folderPaths,
    spacePaths: spacePaths,
    spaces: spaces,
    canCreateSpace: canCreateSpace,
    maxDepth: maxDepth,
    activeId: activeId,
    listPath: listPath,
    libraryPath: libraryPath,
    showPath: showPath,
    createPath: createPath,
    updatePath: updatePath,
    deletePath: deletePath,
    movePath: movePath,
    favoritePath: favoritePath,
    reorderPath: reorderPath,
    duplicatePath: duplicatePath,
    templatePath: templatePath,
    fromTemplatePath: fromTemplatePath,
    dailyPath: dailyPath,
    revisionsPath: revisionsPath,
    revisionPath: revisionPath,
    revisionRestorePath: revisionRestorePath,
    backlinksPath: backlinksPath,
    unlinkedMentionsPath: unlinkedMentionsPath,
    graphPath: graphPath,
    exportPath: exportPath,
    exportOnePath: exportOnePath,
    importPath: importPath,
    searchPath: searchPath,
    tagsListPath: tagsListPath,
    tagsRenamePath: tagsRenamePath,
    tagsMergePath: tagsMergePath,
    tagsDeletePath: tagsDeletePath,
    sharesListPath: sharesListPath,
    sharesPreviewPath: sharesPreviewPath,
    sharesCreatePath: sharesCreatePath,
    sharesRevokePath: sharesRevokePath,
    imageUploadPath: imageUploadPath,
    readPath: readPath,
    coversSearchPath: coversSearchPath,
    personalSpaceId: personalSpaceId,
    craftEnabled: craftEnabled,
    craftPaths: craftPaths,
    imageMaxEdge: imageMaxEdge,
    imageQuality: imageQuality,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
