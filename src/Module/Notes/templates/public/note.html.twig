{#
   La lecture publique d'un espace : la même page que le lecteur du
   back-office, sans rien du back-office.

   L'arbre à gauche et le texte : ce que demande la lecture. Pas de retour
   vers l'édition, pas de favoris, pas de recherche dans les corps - il n'y a
   personne de connecté à qui les proposer. Les moteurs sont tenus à l'écart
   tant que l'espace ne demande pas le contraire.
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {% if indexable %}
            <meta name="robots" content="index, follow">
        {% else %}
            <meta name="robots" content="noindex, nofollow, noarchive">
        {% endif %}
        <meta name="generator" content="Aurora by axelraboit">
        <title>{{ note.title|default('')|trim ?: 'notes.markdown.untitled'|trans }} - {{ publicTitle }}</title>
        {% if siteFaviconUrl %}
            <link rel="icon" href="{{ siteFaviconUrl }}">
        {% else %}
            <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        {% endif %}
        {{ include('@Shared/components/theme_script.html.twig', {colorScheme: true}) }}
        {{ vite_entry_link_tags('app') }}
        {{ include('@Shared/components/primary_color_style.html.twig') }}
        {{ vite_entry_script_tags('app') }}
        {{ vite_entry_script_tags('theme') }}
    </head>
    <body class="min-h-screen bg-body transition-colors duration-200">
        <div {{ vue_component('notes/suite/markdown/NoteReadApp', {
            noteId: note.id,
            noteTitle: note.title,
            content: note.content,
            cover: cover,
            appearance: appearance,
            titleIndex: titleIndex,
            readNotePath: readNotePath,
            imagePrefix: imagePrefix,
            noteImagePath: noteImagePath,
            breadcrumb: breadcrumb,
            canEdit: canEdit,
            favorited: favorited,
            favoritePath: favoritePath,
            backPath: backPath,
            previous: previous,
            next: next,
            libraryPath: libraryPath,
            folderShowPath: folderShowPath,
            treeFolders: treeFolders,
            treeNotes: treeNotes,
            treeSpaces: treeSpaces,
            searchPath: searchPath,
            publicTitle: publicTitle,
        }) }}></div>
    </body>
</html>
