{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ 'backend.nav.settings'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.configuration'|trans},
            {label: 'backend.nav.settings'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('configuration/backend/settings/SettingsApp', {
    groups: groups,
    tabs: tabs,
    updatePath: path('backend_configuration_settings_update'),
    postSearchPath: postSearchPath,
    navSections: sidemenu_nav_sections(),
}) }}></div>
{% endblock %}
