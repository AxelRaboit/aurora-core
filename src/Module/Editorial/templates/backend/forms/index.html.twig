{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ 'backend.nav.forms'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.editorial'|trans},
            {label: 'backend.nav.forms'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('editorial/backend/forms/FormsApp', {
    forms: forms,
    locales: locales,
    fieldTypes: fieldTypes,
    conditionLogics: conditionLogics,
    createPath: path('backend_editorial_forms_create'),
    updatePathTemplate: path('backend_editorial_forms_update', {id: '__id__'}),
    deletePathTemplate: path('backend_editorial_forms_delete', {id: '__id__'}),
    fieldCreatePathTemplate: path('backend_editorial_forms_field_create', {id: '__id__'}),
    fieldEditPathTemplate: path('backend_editorial_forms_field_edit', {id: '__id__', fieldId: '__fieldId__'}),
    fieldDeletePathTemplate: path('backend_editorial_forms_field_delete', {id: '__id__', fieldId: '__fieldId__'}),
    fieldReorderPathTemplate: path('backend_editorial_forms_field_reorder', {id: '__id__'}),
    submissionsPathTemplate: path('backend_editorial_forms_submissions', {id: '__id__'}),
    exportPathTemplate: path('backend_editorial_forms_submissions_export', {id: '__id__'}),
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
