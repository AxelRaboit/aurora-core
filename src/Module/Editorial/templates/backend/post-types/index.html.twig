{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ 'backend.nav.post_types'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.editorial'|trans},
            {label: 'backend.nav.post_types'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('editorial/backend/post-types/PostTypesApp', {
    postTypes: postTypes,
    supportOptions: supportOptions,
    fieldTypes: fieldTypes,
    createPath: path('backend_editorial_post_types_create'),
    updatePathTemplate: path('backend_editorial_post_types_update', {id: '__id__'}),
    deletePathTemplate: path('backend_editorial_post_types_delete', {id: '__id__'}),
    fieldCreatePathTemplate: path('backend_editorial_post_types_field_create', {id: '__id__'}),
    fieldEditPathTemplate: path('backend_editorial_post_types_field_edit', {id: '__id__', fieldId: '__fieldId__'}),
    fieldDeletePathTemplate: path('backend_editorial_post_types_field_delete', {id: '__id__', fieldId: '__fieldId__'}),
    fieldReorderPathTemplate: path('backend_editorial_post_types_field_reorder', {id: '__id__'}),
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
