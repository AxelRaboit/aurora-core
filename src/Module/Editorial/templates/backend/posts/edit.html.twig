{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ 'backend.nav.posts'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.editorial'|trans},
            {label: 'backend.nav.posts'|trans, href: path('backend_editorial_posts')},
            {label: post ? 'backend.posts.edit'|trans : 'backend.posts.create'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('editorial/backend/posts/PostEditorApp', {
    post: post,
    postTypes: postTypes,
    taxonomies: taxonomies,
    locales: locales,
    statusOptions: statusOptions,
    createPath: path('backend_editorial_posts_create'),
    updatePathTemplate: path_template('backend_editorial_posts_update', {id: '__id__'}),
    editPathTemplate: path_template('backend_editorial_posts_edit', {id: '__id__'}),
    listPath: path('backend_editorial_posts'),
    bannerPreviewPath: path('backend_editorial_posts_banner_preview'),
    gridPreviewPath: path('backend_editorial_posts_grid_preview'),
    searchPath: path('backend_editorial_posts_search'),
    previewPathTemplate: path_template('backend_editorial_posts_preview', {id: '__id__'}),
    reviewApprovePathTemplate: path_template('backend_editorial_posts_review_approve', {id: '__id__'}),
    reviewRejectPathTemplate: path_template('backend_editorial_posts_review_reject', {id: '__id__'}),
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
