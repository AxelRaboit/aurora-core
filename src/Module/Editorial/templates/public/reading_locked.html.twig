{# The door of a protected reading link.

   This page says nothing about the post it guards: not its title, not who
   it was prepared for, not which site it comes from. A guessed address must
   learn nothing, and a wrong password answers exactly what a wrong address
   answers. Same shape as a presentation's door, for the same reason. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="noindex, nofollow, noarchive">
        <meta name="referrer" content="no-referrer">
        <title>{{ 'frontend.reading.locked_title'|trans }}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        {{ include('@Shared/components/theme_script.html.twig', {colorScheme: true}) }}
        {{ vite_entry_link_tags('app') }}
        {{ include('@Shared/components/primary_color_style.html.twig') }}
    </head>
    <body class="min-h-screen bg-body">
        <main class="mx-auto flex min-h-screen w-full max-w-sm flex-col justify-center gap-4 p-6">
            <h1 class="m-0 text-lg font-semibold text-primary">
                {{ 'frontend.reading.locked_title'|trans }}
            </h1>
            <p class="m-0 text-sm text-secondary">
                {{ 'frontend.reading.locked_intro'|trans }}
            </p>

            <form method="post" action="{{ path('post_reading_unlock', {token: token}) }}" class="flex flex-col gap-3">
                <label class="flex flex-col gap-1.5">
                    <span class="text-xs uppercase tracking-wide text-muted">
                        {{ 'frontend.reading.locked_password'|trans }}
                    </span>
                    {# `autofocus`: the page has one field and one thing to
                       do, and the reader arrives from an email. #}
                    <input
                        type="password"
                        name="password"
                        autocomplete="current-password"
                        autofocus
                        required
                        class="aurora-card px-3 py-2 text-sm text-primary focus:border-accent focus:outline-none"
                    >
                </label>

                {% if failed %}
                    <p class="m-0 text-sm text-rose-400" role="alert">
                        {{ 'frontend.reading.locked_failed'|trans }}
                    </p>
                {% endif %}

                <button
                    type="submit"
                    class="cursor-pointer rounded-lg bg-accent px-3 py-2 text-sm font-medium text-white hover:bg-accent-600"
                >
                    {{ 'frontend.reading.locked_submit'|trans }}
                </button>
            </form>
        </main>
    </body>
</html>
