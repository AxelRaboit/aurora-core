{% extends '@Core/suite/layout.html.twig' %}

{% block title %}{{ title }} - {{ 'suite.nav.post_galleries'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        backLink: true,
        crumbs: [
            {label: 'suite.nav.sections.editorial'|trans},
            {label: 'suite.nav.post_galleries'|trans, href: path('suite_editorial_post_galleries')},
            {label: title|default('suite.post_galleries.untitled'|trans)},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('editorial/suite/post-galleries/PostGalleryEditorApp', {
    post: post,
    locales: locales,
    updatePath: path('suite_editorial_post_galleries_update', {id: post.id}),
    listPath: path('suite_editorial_post_galleries'),
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
