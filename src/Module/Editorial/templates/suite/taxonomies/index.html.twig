{% extends '@Core/suite/layout.html.twig' %}

{% block title %}{{ 'suite.nav.taxonomies'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'suite.nav.sections.editorial'|trans},
            {label: 'suite.nav.taxonomies'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('editorial/suite/taxonomies/TaxonomiesApp', {
    taxonomies: taxonomies,
    activeId: activeId,
    postTypes: postTypes,
    locales: locales,
    createPath: path('suite_editorial_taxonomies_create'),
    updatePathTemplate: path_template('suite_editorial_taxonomies_update', {id: '__id__'}),
    deletePathTemplate: path_template('suite_editorial_taxonomies_delete', {id: '__id__'}),
    termCreatePathTemplate: path_template('suite_editorial_taxonomies_term_create', {id: '__id__'}),
    termEditPathTemplate: path_template('suite_editorial_taxonomies_term_edit', {id: '__id__', termId: '__termId__'}),
    termDeletePathTemplate: path_template('suite_editorial_taxonomies_term_delete', {id: '__id__', termId: '__termId__'}),
    termReorderPathTemplate: path_template('suite_editorial_taxonomies_term_reorder', {id: '__id__'}),
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
