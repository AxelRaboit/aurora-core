{% extends '@Core/backend/layout.html.twig' %}

{% block title %}{{ deck.title }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'backend.nav.sections.studio'|trans},
            {label: 'backend.nav.studio_decks'|trans, href: backPath},
            {label: deck.title},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('studio/backend/decks/DeckEditorApp', {
    deck: deck,
    layouts: layouts,
    commonSlots: commonSlots,
    listSlots: listSlots,
    themes: themes,
    fontPairs: fontPairs,
    logoPlacements: logoPlacements,
    transitions: transitions,
    appearancePath: appearancePath,
    slideCreatePath: slideCreatePath,
    slideUpdatePath: slideUpdatePath,
    slideDeletePath: slideDeletePath,
    slideDuplicatePath: slideDuplicatePath,
    slideReorderPath: slideReorderPath,
    printPath: printPath,
    presenterPath: presenterPath,
    shareLinks: shareLinks,
    withheldPictures: withheldPictures,
    shareCreatePath: shareCreatePath,
    shareRevokePath: shareRevokePath,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
