{% extends '@Studio/backend/space-content/layout.html.twig' %}

{% set activeTab = 'board' %}

{% block title %}{{ space.name }}{% endblock %}

{% block body %}
<div {{ vue_component('studio/backend/content/SpaceBoardApp', {
    space: space,
    columns: columns,
    items: items,
    itemCreatePath: itemCreatePath,
    itemUpdatePath: itemUpdatePath,
    itemDeletePath: itemDeletePath,
    commentPostPath: commentPostPath,
    commentDeletePath: commentDeletePath,
    comments: comments,
    itemReorderPath: itemReorderPath,
    columnCreatePath: columnCreatePath,
    columnUpdatePath: columnUpdatePath,
    columnDeletePath: columnDeletePath,
    columnReorderPath: columnReorderPath,
}) }}></div>
{% endblock %}
