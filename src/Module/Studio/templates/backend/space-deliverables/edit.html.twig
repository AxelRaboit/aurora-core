{% extends '@Studio/backend/space-content/layout.html.twig' %}

{# Un livrable se compose dans l'espace de son client : la même coquille que
   le tableau, son en-tête et ses deux onglets, et l'onglet « Espace de
   travail » allumé. #}
{% set activeTab = 'content' %}

{% block title %}{{ deliverable.title }} - {{ space.name }}{% endblock %}

{% block body %}
<div {{ vue_component('studio/backend/deliverables/DeliverableEditorApp', {
    deliverable: deliverable,
    space: space,
    locales: locales,
    hiddenZoneTypes: hiddenZoneTypes,
    canEdit: canEdit,
    canShare: canShare,
    canDelete: canDelete,
    canDuplicate: canDuplicate,
    deliverablesPath: deliverablesPath,
    updatePath: updatePath,
    previewPath: previewPath,
    gridPreviewPath: gridPreviewPath,
    bannerPreviewPath: bannerPreviewPath,
    linksPath: linksPath,
    duplicatePath: duplicatePath,
    deletePath: deletePath,
    copyToStudioPath: copyToStudioPath|default(''),
}) }} class="min-w-0"></div>
{% endblock %}
