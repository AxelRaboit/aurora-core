{# A deliverable's page: the reading template around, the grid of the site's
   pages inside. Nothing here has an address on the site, so nothing to index:
   no canonical, no indexing. #}
{% extends 'Frontend/themes/default/reading_layout.html.twig' %}

{% block seo_define %}
    {% do seo({
        title: deliverable.title,
        description: deliverable.summary,
        canonical: '',
        noindex: true,
    }) %}
{% endblock %}

{% block body %}
{# The deliverable's colours, carried by the article alone: the header and the
   footer have their own, repainted by the theme from `surfaceOverrides`. #}
{% if appearance.accentColor %}
    <style>{{ themeStyles.postAccentCss('.aurora-post-accent', appearance.accentColor)|raw }}</style>
{% endif %}
{% set deliverableHighlightCss = themeStyles.postHighlightCss('.aurora-post-highlight', appearance.highlight, appearance.highlightColor) %}
{% if deliverableHighlightCss %}
    <style>{{ deliverableHighlightCss|raw }}</style>
{% endif %}
{# Titles and key figures: theme tokens, set here for the article alone.
   The values are hexadecimals checked on write
   (DeliverableAppearance). #}
{% if appearance.headingColor or appearance.figureColor %}
    {# A zone with forced contrast (a dark gradient, a photo) sets its own text
       colours again: its titles follow its own, not the deliverable's, which
       would be unreadable on it. These zones carry their tokens as inline
       style, hence the selector. #}
    <style>html[data-theme] .aurora-deliverable{
        {%- if appearance.headingColor %}--th-heading: {{ appearance.headingColor }};{% endif -%}
        {%- if appearance.figureColor %}--th-figure: {{ appearance.figureColor }};{% endif -%}
    }
    html[data-theme] .aurora-deliverable [style*="--th-primary"]{--th-heading: var(--th-primary);}</style>
{% endif %}

<article class="prose max-w-none aurora-deliverable{{ appearance.headingStyle|default('theme') == 'display' ? ' aurora-headings-display' : '' }}{{ appearance.accentColor ? ' aurora-post-accent' : '' }}{{ deliverableHighlightCss ? ' aurora-post-highlight' : '' }}">
    {# The title stays in the document when it is hidden: it is the page's only
       `<h1>`, and a text zone does not make one. #}
    {% set hasSummary = appearance.titleVisible and deliverable.summary %}
    <h1 class="{{ appearance.titleVisible ? '' : 'sr-only' }}{{ hasSummary ? ' mb-3' : '' }}">{{ deliverable.title }}</h1>
    {% if hasSummary %}
        <p class="mt-0 text-secondary">{{ deliverable.summary }}</p>
    {% endif %}
    {% if appearance.titleVisible and readingTimeMinutes %}
        <p class="mt-0 text-sm text-muted not-prose">
            {{ 'frontend.editorial.reading_time'|trans({'%minutes%': readingTimeMinutes}) }}
        </p>
    {% endif %}

    {# The reader's PDF, when the author allowed it: the same page, in a
       printable version. Not in the editor's preview nor in the printed
       version. #}
    {% if appearance.readerPdf|default(false) and not print|default(false) and not editorPreview|default(false) %}
        <p class="not-prose mt-0 mb-4 text-sm" data-reader-pdf>
            <a href="?print=1" class="font-medium underline underline-offset-2">{{ 'frontend.reading.download_pdf'|trans }}</a>
        </p>
        <style>@media print{[data-reader-pdf]{display:none}}</style>
    {% endif %}

    {% if slides|default(null) %}
        {# A presentation: one slide per section, stepped through one by one
           by deliverableSlides.js. Without it, they read one after the other,
           and it is still the whole document. #}
        <div class="aurora-slides" data-slides{% if print|default(false) %} data-slides-print{% endif %}>
            {% for slide in slides %}
                <section class="aurora-slide" data-slide id="diapo-{{ loop.index }}" aria-roledescription="{{ 'frontend.slides.slide'|trans }}" aria-label="{{ loop.index }} / {{ slides|length }}">
                    <div class="aurora-slide__inner">
                        {% if markPlaceholders|default(false) %}
                            {% apply mark_placeholders %}{{ include('Frontend/themes/default/editorial/post/_grid.html.twig', {grid: slide, locale: locale}) }}{% endapply %}
                        {% else %}
                            {{ include('Frontend/themes/default/editorial/post/_grid.html.twig', {grid: slide, locale: locale}) }}
                        {% endif %}
                    </div>
                </section>
            {% endfor %}
            <nav class="aurora-slides__controls not-prose" data-slides-controls hidden aria-label="{{ 'frontend.slides.controls'|trans }}">
                <button type="button" class="aurora-slides__button" data-slides-prev aria-label="{{ 'frontend.slides.previous'|trans }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <span class="aurora-slides__counter tabular-nums" data-slides-counter aria-live="polite">1 / {{ slides|length }}</span>
                <button type="button" class="aurora-slides__button" data-slides-next aria-label="{{ 'frontend.slides.next'|trans }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
                {% if viewSwitch|default(null) == 'page' %}
                    {# Read the same document as a page, at the current section. #}
                    <a href="?view=page" class="aurora-slides__button" data-view-switch="page" aria-label="{{ 'frontend.slides.view_page'|trans }}" title="{{ 'frontend.slides.view_page'|trans }}">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 13H8"/><path d="M16 17H8"/><path d="M16 13h-2"/></svg>
                    </a>
                {% endif %}
                <button type="button" class="aurora-slides__button" data-slides-fullscreen aria-label="{{ 'frontend.slides.fullscreen'|trans }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
                </button>
            </nav>
        </div>
    {% elseif grid %}
        {% if markPlaceholders|default(false) %}
            {% apply mark_placeholders %}{{ include('Frontend/themes/default/editorial/post/_grid.html.twig', {grid: grid, locale: locale}) }}{% endapply %}
        {% else %}
            {{ include('Frontend/themes/default/editorial/post/_grid.html.twig', {grid: grid, locale: locale}) }}
        {% endif %}
        {% if viewSwitch|default(null) == 'slides' %}
            {# Read as a page, a way to view it as a presentation: the same
               bar, in the same place as the slides' one, stuck to the bottom
               of the screen while reading, to pick up at the current section.
               The author's view stays the default one. #}
            <nav class="aurora-slides__controls not-prose" aria-label="{{ 'frontend.slides.view_slides'|trans }}">
                <a href="?view=slides" class="aurora-slides__button" data-view-switch="slides" aria-label="{{ 'frontend.slides.view_slides'|trans }}" title="{{ 'frontend.slides.view_slides'|trans }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/><path d="m7 21 5-5 5 5"/></svg>
                </a>
            </nav>
        {% endif %}
    {% endif %}
</article>
{% endblock %}
