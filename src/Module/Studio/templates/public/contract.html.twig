{% extends '@Studio/public/layout.html.twig' %}

{% set contractLocale = contract.locale %}

{% block title %}{{ 'studio.public.contract.title'|trans({}, null, contract.locale) }} {{ contract.reference }}{% endblock %}

{% block body %}
    <header class="space-y-2">
        <p class="font-mono text-2xs uppercase tracking-widest text-muted">
            {{ contract.reference }}
        </p>
        <h1 class="text-xl font-semibold text-primary">
            {{ 'studio.public.contract.heading'|trans({}, null, contract.locale) }}
        </h1>
        <p class="text-sm text-secondary">
            {{ 'studio.public.contract.intro'|trans({'{company}': customer.legalName}, null, contract.locale) }}
        </p>
    </header>

    {% if isConcluded %}
        {# Fully signed. Nothing is asked of the reader any more, so the page
           says that first rather than leaving them looking for a button. #}
        <div class="rounded-lg border border-emerald-500/40 bg-emerald-500/5 p-4 text-sm">
            <p class="font-medium text-emerald-500">
                {{ 'studio.public.contract.concluded'|trans({}, null, contract.locale) }}
            </p>
        </div>
    {% elseif isRefused %}
        {# An answer, not an absence. The reader gets told what was recorded and
           that it is not final for them to fix - the provider can send it
           again, so nobody is stuck on a page they closed a door on. #}
        <div class="rounded-lg border border-amber-500/40 bg-amber-500/5 p-4 text-sm space-y-1">
            <p class="font-medium text-amber-500">
                {{ 'studio.public.contract.refused'|trans({}, null, contract.locale) }}
            </p>
            <p class="text-secondary">
                {{ 'studio.public.contract.refused_hint'|trans({'{date}': contract.refusedAt|date('d/m/Y')}, null, contract.locale) }}
            </p>
        </div>
    {% elseif isSigned %}
        <div class="rounded-lg border border-emerald-500/40 bg-emerald-500/5 p-4 text-sm space-y-1">
            <p class="font-medium text-emerald-500">
                {{ 'studio.public.contract.signed'|trans({}, null, contract.locale) }}
            </p>
            <p class="text-secondary">
                {{ 'studio.public.contract.signed_hint'|trans({}, null, contract.locale) }}
            </p>
        </div>
    {% else %}
        {# What happens next, before the document rather than after it. Reading
           nineteen articles and only then discovering what is being asked is
           the wrong order. #}
        <div class="aurora-card p-4 text-sm space-y-1">
            <p class="font-medium text-primary">
                {{ 'studio.public.contract.to_sign'|trans({}, null, contract.locale) }}
            </p>
            <p class="text-secondary">
                {{ 'studio.public.contract.to_sign_hint'|trans({}, null, contract.locale) }}
            </p>
            <p class="text-xs text-muted pt-1">
                {{ 'studio.public.contract.valid_until'|trans({'{date}': link.expiresAt|date('d/m/Y')}, null, contract.locale) }}
            </p>
        </div>
    {% endif %}

    {# The document, printed from the stored HTML and never re-rendered: this is
       byte for byte what the hash covers, which is the whole point of having
       sealed it. `raw` is safe here because the renderer that produced it
       sanitised every text and escaped every substituted value. #}
    <article class="aurora-card contract-document p-6 sm:p-8">
        {{ documentHtml|raw }}
    </article>

    {# The form comes after the document, which is the order the page asks for
       things: read, then sign. #}
    {% if not isSigned and not isRefused %}
        <div {{ vue_component('studio/public/sign/ContractSignApp', {
            codePath: codePath,
            signPath: signPath,
            refusePath: refusePath,
        }) }}></div>
    {% endif %}

    {# After the form, before the fingerprint: the reader has seen what is
       asked of them, and this says what happens to it. #}
    {{ include('@Studio/public/_privacy.html.twig') }}

    <p class="text-xs text-muted">
        {{ 'studio.public.contract.hash_notice'|trans({'{hash}': contract.contentHash|slice(0, 16)}, null, contract.locale) }}
    </p>
{% endblock %}

{% block footer %}
    {{ 'studio.public.contract.footer'|trans({}, null, contract.locale) }}
{% endblock %}
