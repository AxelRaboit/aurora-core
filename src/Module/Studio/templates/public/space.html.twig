{# A client space opened by a secret address.

   Its own page, with no menu and no account: whoever opens it has none, and
   that is the reason for the address. Modelled on a presentation's public page
   rather than a contract's, for the same reason: a content plan is looked at
   as a grid, and a 3xl reading column chokes a month.

   Nothing here allows writing by default. The three rights - approve, comment,
   send a file - each come with the column that carries it and the rate limit a
   guest write calls for. Sending a file is the only one that arrives switched
   off, because it writes bytes into our storage. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {# Nothing here is meant to be found. The address is a secret handed to
           someone, and a search engine that indexed it would hand it to
           everyone, for good and out of reach of any revocation. #}
        <meta name="robots" content="noindex, nofollow, noarchive">
        <meta name="referrer" content="no-referrer">
        <title>{{ space.name }}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        {{ include('@Shared/components/theme_script.html.twig', {colorScheme: true}) }}
        {{ vite_entry_link_tags('app') }}
        {{ include('@Shared/components/primary_color_style.html.twig') }}
        {{ vite_entry_script_tags('app') }}
        {{ vite_entry_script_tags('theme') }}
    </head>
    <body class="min-h-screen bg-body transition-colors duration-200">
        <div {{ vue_component('studio/frontend/space/PublicSpaceApp', {
            space: space,
            columns: columns,
            items: items,
            expiresAt: expiresAt ? expiresAt|date('c') : null,
            canApprove: canApprove,
            answerPath: answerPath,
            approveManyPath: approveManyPath,
            canComment: canComment,
            comments: comments,
            commentPath: commentPath,
            canUpload: canUpload,
            preview: preview|default(false),
            attachments: attachments,
            uploadPath: uploadPath,
            chatMessages: chatMessages,
            chatStreamUrl: chatStreamUrl,
            chatPostPath: chatPostPath,
            chatReloadPath: chatReloadPath,
    chatChannels: chatChannels,
    chatChannelId: chatChannelId,
    chatDirectPath: chatDirectPath,
    chatOlderPath: chatOlderPath,
    chatHidePath: chatHidePath,
    chatPeople: chatPeople,
            spaceFiles: spaceFiles,
            spaceFileUploadPath: spaceFileUploadPath,
            drivePath: drivePath,
            driveFilePath: driveFilePath,
            driveArchivePath: driveArchivePath,
            information: information,
            resources: resources,
            documents: documents,
        }) }} class="min-h-screen"></div>
    </body>
</html>
