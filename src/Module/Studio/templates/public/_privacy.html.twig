{# The article 13 notice, at the moment of collection.

   Folded into a `<details>` and not a modal: a reader who wants it opens it
   without leaving the page they are being asked to sign, and a reader who does
   not is not made to dismiss anything. Always present, including once the
   contract is signed or refused - the data was collected either way, and the
   page is the only place this person can come back to.

   Every figure it prints is read from the application: the controller from the
   provider settings the document itself prints, the retention from the value
   the deletion guard enforces. Nothing here is a number typed twice. #}
<details class="aurora-card px-4 py-3 text-sm">
    <summary class="cursor-pointer font-medium text-primary">
        {{ 'studio.public.privacy.title'|trans({}, null, privacy.locale) }}
    </summary>

    <div class="space-y-3 pt-3 text-secondary">
        {% if privacy.controller is not empty %}
            <p>
                {{ 'studio.public.privacy.controller'|trans({'{controller}': privacy.controller|join(' · ')}, null, privacy.locale) }}
            </p>
        {% endif %}

        <div class="space-y-1">
            <p class="font-medium text-primary">
                {{ 'studio.public.privacy.collected_title'|trans({}, null, privacy.locale) }}
            </p>
            <ul class="list-disc space-y-1 pl-5">
                <li>{{ 'studio.public.privacy.collected_declared'|trans({}, null, privacy.locale) }}</li>
                <li>{{ 'studio.public.privacy.collected_observed'|trans({}, null, privacy.locale) }}</li>
                <li>{{ 'studio.public.privacy.collected_refusal'|trans({}, null, privacy.locale) }}</li>
            </ul>
        </div>

        <div class="space-y-1">
            <p class="font-medium text-primary">
                {{ 'studio.public.privacy.basis_title'|trans({}, null, privacy.locale) }}
            </p>
            <ul class="list-disc space-y-1 pl-5">
                <li>{{ 'studio.public.privacy.basis_contract'|trans({}, null, privacy.locale) }}</li>
                <li>{{ 'studio.public.privacy.basis_proof'|trans({}, null, privacy.locale) }}</li>
            </ul>
        </div>

        <p>
            {{ 'studio.public.privacy.retention'|trans({'{years}': privacy.retentionYears}, null, privacy.locale) }}
        </p>

        <p>{{ 'studio.public.privacy.no_transfer'|trans({}, null, privacy.locale) }}</p>

        <p>
            {{ 'studio.public.privacy.rights'|trans({}, null, privacy.locale) }}
            {% if privacy.email %}
                {{ 'studio.public.privacy.rights_contact'|trans({'{email}': privacy.email}, null, privacy.locale) }}
            {% endif %}
        </p>

        <p>{{ 'studio.public.privacy.complaint'|trans({}, null, privacy.locale) }}</p>
    </div>
</details>
