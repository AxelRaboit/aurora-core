{% extends '@Core/suite/layout.html.twig' %}

{% block title %}{{ 'suite.nav.studio_calendar'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'suite.nav.sections.studio'|trans},
            {label: 'suite.nav.studio_spaces'|trans, href: path('suite_studio_spaces')},
            {label: 'suite.nav.studio_calendar'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('studio/suite/calendar/StudioCalendarApp', {
    scope: scope,
    hasScopeChoice: hasScopeChoice,
    spaces: spaces,
    itemsPath: itemsPath,
    spacesPath: spacesPath,
    calendarPath: calendarPath,
}) }}></div>
{% endblock %}
