{% extends '@Core/suite/layout.html.twig' %}

{% block title %}{{ 'suite.nav.studio_customers'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'suite.nav.sections.studio'|trans},
            {label: 'suite.nav.studio_customers'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
{# `spacesPath`: the address of the spaces list, to go there from a client.
   The company name is sent as the search, which is what that list searches.
   The comment is here and not in the call: inside a Twig expression, `{#` is
   not a comment and the apostrophe breaks the template. #}
<div {{ vue_component('studio/suite/customers/CustomersApp', {
    customers: customers,
    currencies: currencies,
    locales: locales,
    createPath: createPath,
    showPath: showPath,
    convertPath: convertPath,
    deletePath: deletePath,
    spacesPath: path('suite_studio_spaces'),
    pipeline: pipeline,
    pipelinePaths: {
        movePath: pipelinePaths.movePath,
        stageCreatePath: pipelinePaths.stageCreatePath,
        stageUpdatePath: pipelinePaths.stageUpdatePath,
        stageDeletePath: pipelinePaths.stageDeletePath,
        stageReorderPath: pipelinePaths.stageReorderPath,
    },
    sources: sources,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
