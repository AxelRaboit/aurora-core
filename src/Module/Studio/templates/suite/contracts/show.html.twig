{% extends '@Core/suite/layout.html.twig' %}

{% block title %}{{ contract.reference ?? 'suite.studio.contracts.draft_title'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        backLink: true,
        crumbs: [
            {label: 'suite.nav.sections.studio'|trans},
            {label: 'suite.nav.studio_contracts'|trans, href: indexPath},
            {label: contract.reference ?? contract.customerName},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('studio/suite/contracts/ContractDocumentApp', {
    contract: contract,
    indexPath: indexPath,
    updatePath: updatePath,
    deletePath: deletePath,
    previewPath: previewPath,
    freezePath: freezePath,
    sendPath: sendPath,
    remindPath: remindPath,
    revokeLinkPath: revokeLinkPath,
    cancelPath: cancelPath,
    duplicatePath: duplicatePath,
    countersignPath: countersignPath,
    pdfPath: pdfPath,
    exportPath: exportPath,
    terminatePath: terminatePath,
    terminationOrigins: terminationOrigins,
    linkDays: linkDays,
    amendPath: amendPath,
    showPath: showPath,
    templateVersionPath: templateVersionPath,
    wordingPath: wordingPath,
    customers: customers,
    bodies: bodies,
    annexes: annexes,
    locales: locales,
    currencies: currencies,
    amendable: amendable,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
