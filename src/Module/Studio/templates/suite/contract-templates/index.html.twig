{% extends '@Core/suite/layout.html.twig' %}

{% block title %}{{ 'suite.studio.contract_templates.tab'|trans }} - {{ 'suite.nav.studio_contracts'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'suite.nav.sections.studio'|trans},
            {label: 'suite.nav.studio_contracts'|trans, href: path('suite_studio_contracts')},
            {label: 'suite.studio.contract_templates.tab'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('studio/suite/contract-templates/ContractTemplatesApp', {
    templates: templates,
    kinds: kinds,
    categories: categories,
    contractsPath: contractsPath,
    templatesPath: templatesPath,
    categoryCreatePath: categoryCreatePath,
    categoryUpdatePath: categoryUpdatePath,
    categoryDeletePath: categoryDeletePath,
    categoryReorderPath: categoryReorderPath,
    createPath: createPath,
    updatePath: updatePath,
    archivePath: archivePath,
    restorePath: restorePath,
    deletePath: deletePath,
    openDraftPath: openDraftPath,
    duplicatePath: duplicatePath,
    discardDraftPath: discardDraftPath,
    editorPath: editorPath,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
