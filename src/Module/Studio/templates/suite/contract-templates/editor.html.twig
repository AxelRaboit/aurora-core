{% extends '@Core/suite/layout.html.twig' %}

{% block title %}{{ template.name }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'suite.nav.sections.studio'|trans},
            {label: 'suite.nav.studio_contracts'|trans, href: path('suite_studio_contracts')},
            {label: 'suite.studio.contract_templates.tab'|trans, href: indexPath},
            {label: template.name},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('studio/suite/contract-templates/ContractTemplateEditorApp', {
    template: template,
    version: version,
    versions: versions,
    locales: locales,
    variableGroups: variableGroups,
    savePath: savePath,
    publishPath: publishPath,
    discardPath: discardPath,
    previewPath: previewPath,
    indexPath: indexPath,
    editorPath: editorPath,
    openDraftPath: openDraftPath,
    inForceVersionId: inForceVersionId,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
