{% extends '@Studio/suite/space-content/layout.html.twig' %}

{# A deliverable is composed in its client's space: the same shell as the
   board, its header and its two tabs, with the "Espace de travail" tab
   active. #}
{% set activeTab = 'content' %}

{% block title %}{{ deliverable.title }} - {{ space.name }}{% endblock %}

{% block body %}
<div {{ vue_component('studio/suite/deliverables/DeliverableEditorApp', {
    deliverable: deliverable,
    space: space,
    locales: locales,
    hiddenZoneTypes: hiddenZoneTypes,
    canEdit: canEdit,
    canShare: canShare,
    canDelete: canDelete,
    canDuplicate: canDuplicate,
    deliverablesPath: deliverablesPath,
    updatePath: updatePath,
    previewPath: previewPath,
    gridPreviewPath: gridPreviewPath,
    bannerPreviewPath: bannerPreviewPath,
    linksPath: linksPath,
    duplicatePath: duplicatePath,
    deletePath: deletePath,
    copyToStudioPath: copyToStudioPath|default(''),
}) }} class="min-w-0"></div>
{% endblock %}
