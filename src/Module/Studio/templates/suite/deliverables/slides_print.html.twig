{# La présentation, sur papier.

   Sa propre page plutôt qu'une feuille d'impression posée sur l'éditeur :
   masquer un back-office par sélecteur demande de connaître son balisage, puis
   de le connaître encore à chaque fois qu'il change. Ici il n'y a rien à
   masquer. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="noindex, nofollow">
        <title>{{ deck.title }}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        {{ include('@Shared/components/theme_script.html.twig', {colorScheme: true}) }}
        {{ vite_entry_link_tags('app') }}
        {{ include('@Shared/components/primary_color_style.html.twig') }}
        {{ vite_entry_script_tags('app') }}
        {{ vite_entry_script_tags('theme') }}
    </head>
    <body class="bg-body">
        <div {{ vue_component('studio/suite/slides/DeckPrintApp', {
            deck: deck,
            autoPrint: autoPrint,
        }) }}></div>
    </body>
</html>
