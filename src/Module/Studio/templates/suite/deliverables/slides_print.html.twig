{# The presentation, on paper.

   Its own page rather than a print stylesheet laid on the editor: hiding a
   back office by selector means knowing its markup, then knowing it again
   every time it changes. Here there is nothing to hide. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="noindex, nofollow">
        <title>{{ deck.title }}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        {{ include('@Shared/components/theme_script.html.twig', {colorScheme: true}) }}
        {{ vite_entry_link_tags('app') }}
        {{ include('@Shared/components/primary_color_style.html.twig') }}
        {{ vite_entry_script_tags('app') }}
        {{ vite_entry_script_tags('theme') }}
    </head>
    <body class="bg-body">
        <div {{ vue_component('studio/suite/slides/DeckPrintApp', {
            deck: deck,
            autoPrint: autoPrint,
        }) }}></div>
    </body>
</html>
