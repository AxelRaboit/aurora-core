{% extends '@Studio/suite/space-content/layout.html.twig' %}

{% set activeTab = 'access' %}

{% block title %}{{ space.name }}{% endblock %}

{% block body %}
<div {{ vue_component('studio/suite/access/SpaceAccessApp', {
    space: space,
    links: links,
    defaultValidDays: defaultValidDays,
    maxValidDays: maxValidDays,
    issuePath: issuePath,
    revokePath: revokePath,
    deletePath: deletePath,
    driveFolderId: driveFolderId,
    previewPath: previewPath,
    aliasPath: aliasPath,
    aliasRemovePath: aliasRemovePath,
    invitePath: invitePath,
    extendPath: extendPath,
}) }}></div>
{% endblock %}
