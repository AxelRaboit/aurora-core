{# Both parties, same message: it is done. The signed PDF is attached when
   it exists, and the provider's copy links to the contract in the back
   office. #}
<p>{{ 'studio.email.concluded.body'|trans({'{reference}': contract.reference}) }}</p>

<p>{{ 'studio.email.concluded.hash'|trans({'{hash}': contract.contentHash|slice(0, 16)}) }}</p>

{% if forProvider ?? false %}
    <p><a href="{{ url('suite_studio_contracts_show', {id: contract.id}) }}">{{ 'studio.email.open_contract'|trans }}</a></p>
{% endif %}
