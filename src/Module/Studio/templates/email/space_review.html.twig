{% extends '@Shared/email/layout/base.html.twig' %}

{# The invitation to review a content plan, sent by hand by the studio.

   The address is the one the client already has, rebuilt by the application:
   nothing was revoked to send it, so a bookmark keeps working.

   The pending count is in the body and in the subject: it is what decides
   whether to open it now or tonight. #}
{% block content %}
<p>{{ 'studio.email.space_review.body'|trans({'{space}': space.name, '{count}': awaiting, '%count%': awaiting}) }}</p>

{{ include('@Shared/email/partials/action_button.html.twig', {
    url: url,
    label: 'studio.email.space_review.cta'|trans,
}) }}

<p class="warning">{{ 'studio.email.space_review.expires'|trans({'{date}': expiresAt|site_date}) }}</p>
{% endblock %}
