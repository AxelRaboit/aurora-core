{# The provider's cue that a contract got an answer, and the answer was no.

   Carries the reason when the customer gave one, because that is the whole
   commercial value of the mail, and the trace of where the refusal came from.
   No link to the document: the address the customer used has just been
   revoked, and the provider reads it from the back-office. #}
<p>{{ 'studio.email.customer_refused.body'|trans({'{reference}': contract.reference, '{customer}': customer.legalName}) }}</p>

<ul>
    <li>{{ 'studio.email.customer_refused.observed'|trans({'{at}': refusedAt|date('d/m/Y H:i'), '{ip}': contract.refusedFromIp ?? '-'}) }}</li>
</ul>

{% if reason %}
    <p>{{ 'studio.email.customer_refused.reason'|trans }}</p>
    <blockquote>{{ reason }}</blockquote>
{% else %}
    <p>{{ 'studio.email.customer_refused.no_reason'|trans }}</p>
{% endif %}

<p>{{ 'studio.email.customer_refused.action'|trans }}</p>

{# The contract itself, one click away: the mail said « depuis le back-office »
   and gave no address. #}
<p><a href="{{ url('backend_studio_contracts_show', {id: contract.id}) }}">{{ 'studio.email.open_contract'|trans }}</a></p>
