{% extends '@Shared/email/layout/base.html.twig' %}

{# The customer's copy of their refusal: what was declined, when, and in
   their words. A refusal binds nobody, and the mail says so - the provider
   may send a new version, which will come with a new link. #}
{% block content %}
<p>{{ 'studio.email.refusal_received.body'|trans({'{reference}': contract.reference, '{at}': refusedAt|site_datetime}) }}</p>

{% if reason %}
<p>{{ 'studio.email.refusal_received.reason'|trans }}</p>
<table class="panel" role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
    <tr>
        <td class="panel-content">{{ reason }}</td>
    </tr>
</table>
{% endif %}

<p>{{ 'studio.email.refusal_received.next'|trans({'{company}': siteName}) }}</p>
{% endblock %}
