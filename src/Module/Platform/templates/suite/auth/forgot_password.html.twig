{% extends '@Core/suite/base_guest.html.twig' %}

{% block title %}{{ 'suite.auth.forgot_password.title'|trans }} - {{ parent() }}{% endblock %}

{% block hero %}
    {{ include('@Shared/components/auth_hero.html.twig') }}
{% endblock %}

{% block form_icon %}key-round{% endblock %}
{% block form_title %}{{ 'suite.auth.forgot_password.title'|trans }}{% endblock %}

{% block content %}
    <div {{ vue_component('platform/suite/auth/ForgotPasswordApp', {
        submitPath: path('suite_platform_forgot_password'),
        loginPath: path('suite_platform_login'),
        status: status ?? '',
    }) }}></div>
{% endblock %}
