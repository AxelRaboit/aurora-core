{% extends '@Core/suite/layout.html.twig' %}

{% block title %}{{ 'suite.nav.ged_categories'|trans }} - {{ parent() }}{% endblock %}

{% block page_header_slot %}
    {{ include('@Shared/components/page_header.html.twig', {
        crumbs: [
            {label: 'suite.nav.sections.ged'|trans},
            {label: 'suite.nav.ged_categories'|trans},
        ],
    }) }}
{% endblock %}

{% block body %}
<div {{ vue_component('ged/suite/document-categories/DocumentCategoriesApp', {
    categories: categories,
    search: search,
    createPath: createPath,
    updatePath: updatePath,
    deletePath: deletePath,
    restorePath: restorePath,
    forceDeletePath: forceDeletePath,
    emptyTrashPath: emptyTrashPath,
    listPath: listPath,
}) }} class="flex-1 min-w-0"></div>
{% endblock %}
