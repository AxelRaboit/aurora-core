<!DOCTYPE html>
{# The collapsed class is rendered here rather than added by a script: it is
   stored on the user, so the first paint already has it and the menu no longer
   starts expanded and snaps shut. The width still comes from the browser - see
   theme_script. #}
<html lang="{{ app.request.locale }}"{% if app.user and app.user.sidemenuCollapsed %} class="sidemenu-collapsed"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content="Aurora by axelraboit">
    <!-- Built with Aurora · © axelraboit · https://github.com/AxelRaboit -->
    <title>{% block title %}{{ siteName }}{% endblock %}</title>
    {% if siteFaviconUrl %}
        <link rel="icon" href="{{ siteFaviconUrl }}">
    {% else %}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    {% endif %}
    {{ include('@Shared/components/theme_script.html.twig', {colorScheme: true, sidemenu: true}) }}
    {% block stylesheets %}
        {{ vite_entry_link_tags('app') }}
        {{ vite_entry_link_tags('flash') }}
    {% endblock %}
    {# Inject after Vite stylesheets so the runtime --th-accent-* override wins over the defaults baked into app.css. #}
    {{ include('@Shared/components/primary_color_style.html.twig') }}
    {{ include('@Shared/components/suite_globals.html.twig') }}
    {% block javascripts %}
        {{ vite_entry_script_tags('app') }}
        {{ vite_entry_script_tags('flash') }}
    {% endblock %}
</head>
<body class="transition-colors duration-200">

{{ include('@Shared/components/app_loader.html.twig') }}

<div class="min-h-screen bg-bg">

    {# `moduleNavView` is null on every page today: no module declares a view
       yet, so the menu never leaves its project view. It is resolved
       server-side rather than in the browser so the first paint is already the
       right view - deciding client-side would show the project menu and swap it
       a frame later, in front of the reader.

       Note for whoever edits the hash below: a Twig comment opened inside a
       Twig hash literal is a syntax error, not a comment - Twig reads the brace
       as part of the expression. Annotate the keys from out here. #}
    <div {{ vue_component('core/suite/sidemenu/AppSidemenu', {
        navSections: sidemenu_nav_sections(true),
        navSectionAliases: nav_section_aliases(),
        navItemAliases: nav_item_aliases(),
        navSectionColors: app.user.navSectionColors|default({}),
        moduleNavView: module_nav_view(app.request.attributes.get('_route')),
        userName: app.user.name,
        userEmail: app.user.email,
        userPhotoUrl: aurora_profile_photo_url(app.user) ?? '',
        activeRoute: app.request.attributes.get('_route'),
        logoutCsrf: csrf_token('logout'),
        frontPath: path('frontend_root'),
        hasEnabledFronts: has_enabled_fronts(),
        profilePath: path('suite_general_profile'),
        sidemenuPreferencesPath: path('suite_general_profile_sidemenu'),
        sidemenuCollapsedPath: path('suite_general_profile_sidemenu_collapsed'),
        logoutPath: path('suite_platform_logout'),
        locale: app.request.locale,
        mailpitUrl: aurora_is_dev() ? 'http://127.0.0.1:8025' : '',
        siteName: siteName ?? '',
        siteLogoUrl: siteLogoUrl ?? '',
        siteNameOnPhone: siteNameOnPhone ?? true,
        appVersion: appVersion is defined ? appVersion : '',
        searchPath: path('suite_general_search'),
        notificationsListPath: path('suite_notifications_list'),
        notificationsMarkReadPath: path_template('suite_notifications_mark_read', {id: '__id__'}),
        notificationsMarkAllReadPath: path('suite_notifications_mark_all_read'),
        notificationsDeletePath: path_template('suite_notifications_delete', {id: '__id__'}),
        notificationsDeleteAllPath: path('suite_notifications_delete_all'),
    }) }}></div>

    <div id="main-content" class="flex-1 flex flex-col min-h-screen transition-colors duration-200 pt-14 lg:pt-0">

        {% block page_header_slot %}{% endblock %}

        {# Shows itself only once the server runs a newer version than the one
           this page was rendered with: a tab left open across a deployment. #}
        <div {{ vue_component('core/suite/version/AppVersionWatch', {
            version: appVersion is defined ? appVersion : '',
            versionPath: path('suite_version'),
        }) }}></div>

        {% set pending_migrations = aurora_is_dev() ? aurora_pending_migrations() : 0 %}
        {% if pending_migrations > 0 %}
            {% embed '@Shared/components/app_message.html.twig' with {variant: 'warning', strip: true, icon: 'database'} %}
                {% block content %}
                    {{ 'suite.migrations.pending.banner'|trans({'{count}': pending_migrations, '%count%': pending_migrations}) }}
                {% endblock %}
                {% block actions %}
                    <code class="ml-2 font-mono text-xs px-1.5 py-0.5 rounded bg-warning/10 border border-warning/30">make migrate</code>
                {% endblock %}
            {% endembed %}
        {% endif %}

        {% if aurora_is_dev() %}
            {% for warning in aurora_dev_warnings() %}
                {% set variant = warning.level == 'warning' ? 'warning' : 'info' %}
                {% set icon = warning.level == 'warning' ? 'triangle-alert' : 'info' %}
                {% embed '@Shared/components/app_message.html.twig' with {variant: variant, strip: true, icon: icon} %}
                    {% block content %}{{ warning.message }}{% endblock %}
                    {% block actions %}
                        <code class="ml-2 font-mono text-xs px-1.5 py-0.5 rounded bg-current/10 border border-current/30 opacity-70">{{ warning.fix }}</code>
                    {% endblock %}
                {% endembed %}
            {% endfor %}
        {% endif %}

        {% if is_granted('IS_IMPERSONATOR') %}
            {% embed '@Shared/components/app_message.html.twig' with {variant: 'warning', strip: true, icon: 'user-check'} %}
                {% block content %}{{ 'suite.impersonation.banner'|trans({'{name}': app.user.name}) }}{% endblock %}
                {% block actions %}
                    {{ include('@Shared/components/app_link.html.twig', {
                        href: path('suite_dashboard', {_switch_user: '_exit'}),
                        variant: 'inherit',
                        extraClass: 'ml-2 font-medium',
                        label: 'suite.impersonation.leave'|trans,
                    }) }}
                {% endblock %}
            {% endembed %}
        {% endif %}

        {# The page margin lives in `spacing.css`, in two variables that the
           banner above reads too. It was written here in Tailwind, and the
           banner wrote its own on its side: the two diverged on a phone,
           eight pixels against sixteen, and the title no longer lined up
           vertically with the content it names. #}
        <main class="aurora-page flex-1">
            {% block body %}{% endblock %}
        </main>
    </div>
</div>

</body>
</html>
