{# The page a reading link opens: a publication with none of the site around it.

   It extends the site's layout rather than copying it, so the theme - fonts,
   colours, the head and its stylesheet - is the same one, and replaces only
   the two blocks that lead back into the site. No menu, no footer of links:
   whoever holds the link was sent one document, not the site.

   What the header says is chosen per publication (`reading`, from
   ReadingPageNormalizer): the site's logo and name, who it was prepared for,
   and when it was last brought up to date. The language switch lists only the
   languages the publication is written in, each pointing at this same link. #}
{% extends 'Frontend/themes/default/layout.html.twig' %}

{% block frontend_header %}
    {% set reading = reading|default({}) %}
    {% set readingLocales = context.activeLocales|filter(loc => (reading.localeUrls|default({}))[loc.code] is defined) %}
    <header class="aurora-surface aurora-surface-header border-b border-line print:hidden{{ chromeClass|default('') ? ' ' ~ chromeClass }}">
        {# No wrap on the outer row: the language switch stays top right on a
           phone rather than taking a line of its own under the name. #}
        <div class="max-w-7xl mx-auto px-4 py-4 flex items-start justify-between gap-4 sm:items-center">
            <div class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1">
                {% if reading.backUrl|default(null) %}
                    {# The arrow alone on a phone, with no frame around it but
                       a square a thumb can still hit; the words come back from
                       the tablet up. The label stays for a screen reader either
                       way. #}
                    <a
                        href="{{ reading.backUrl }}"
                        aria-label="{{ 'frontend.reading.back'|trans }}"
                        class="inline-flex h-[38px] w-[38px] shrink-0 items-center justify-start text-sm text-secondary hover:text-highlight sm:h-auto sm:w-auto sm:gap-1.5"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                        <span class="hidden sm:inline">{{ 'frontend.reading.back'|trans }}</span>
                    </a>
                {% endif %}
                {% if reading.showLogo|default(true) %}
                    <span class="flex items-center gap-2 text-lg font-semibold text-primary">
                        {% set headerLogoUrl = themeContext.headerLogoUrl() %}
                        {% if headerLogoUrl %}<img src="{{ headerLogoUrl }}" alt="" class="h-8 w-8 object-cover rounded-lg shrink-0">{% endif %}
                        {{ themeContext.headerCustomText() ?: context.siteName }}
                    </span>
                {% endif %}
                {% if reading.preparedFor|default(null) or reading.showDate|default(true) %}
                    <p class="m-0 flex flex-wrap gap-x-3 text-sm text-secondary">
                        {% if reading.preparedFor|default(null) %}
                            <span>{{ 'frontend.reading.prepared_for'|trans({'%name%': reading.preparedFor}) }}</span>
                        {% endif %}
                        {% if reading.showDate|default(true) and reading.updatedOn|default(null) %}
                            <span class="text-muted">{{ 'frontend.reading.updated_on'|trans({'%date%': reading.updatedOn}) }}</span>
                        {% endif %}
                    </p>
                {% endif %}
            </div>

            {% if readingLocales|length > 1 %}
                {{ include('Frontend/themes/default/partials/locale_switcher.html.twig', {
                    locales: readingLocales,
                    current: locale,
                    urls: reading.localeUrls,
                }) }}
            {% endif %}
        </div>
    </header>
{% endblock %}

{% block frontend_footer %}
    <footer class="aurora-surface aurora-surface-footer border-t border-line mt-12 print:hidden{{ chromeClass|default('') ? ' ' ~ chromeClass }}">
        <div class="max-w-7xl mx-auto px-4 py-6">
            <p class="m-0 text-center text-sm text-muted">{{ 'frontend.reading.footer'|trans }}</p>
        </div>
    </footer>
{% endblock %}
