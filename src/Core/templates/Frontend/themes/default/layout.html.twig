<!DOCTYPE html>
<html lang="{{ locale }}" data-theme>
<head>
    {% set alternates = alternates|default([]) %}
    {# Passerelles override `seo_define` to call `{% do seo({...}) %}` - must render before head include. #}
    {% block seo_define %}{% do seo({}) %}{% endblock %}
    <!-- Built with Aurora · © axelraboit · https://github.com/AxelRaboit -->
    <meta name="generator" content="Aurora by axelraboit">
    {{ include('Frontend/themes/default/partials/head.html.twig') }}
</head>
<body class="min-h-screen bg-bg text-primary flex flex-col">
    {% set alternatesByLocale = {} %}
    {% for alt in alternates %}
        {% set alternatesByLocale = alternatesByLocale|merge({(alt.locale): alt.url}) %}
    {% endfor %}

    {# Chrome stays module-independent by asking rather than knowing: `menu_items()`
       answers with an empty list when menus are off, when nothing is bound to the
       location, or when nothing in it is visible to this visitor. Every nav below
       is therefore guarded on emptiness alone, and the layout never tests whether
       a module is installed. A theme wanting different chrome overrides this file;
       see docs/aurora-core/dev/frontend_theme_override.md. #}
    {% set primaryMenu = menu_items('primary', locale) %}
    {% set accountMenu = menu_items('account', locale) %}
    {% set footerMenu = menu_items('footer', locale) %}

    {% block frontend_header %}
    <header class="aurora-surface aurora-surface-header border-b border-line">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-4">
            <a href="{{ default_front_home_path(locale) }}" class="flex items-center gap-2 text-lg font-semibold text-primary hover:opacity-80 transition-opacity">
                {% set headerLogoUrl = themeContext.headerLogoUrl() %}
                {% if headerLogoUrl %}<img src="{{ headerLogoUrl }}" alt="" class="h-8 w-8 object-cover rounded-lg shrink-0">{% endif %}
                {{ themeContext.headerCustomText() ?: context.siteName }}
            </a>

            {% if primaryMenu is not empty %}
                <nav class="flex flex-wrap items-center gap-5 text-sm order-last w-full md:order-none md:w-auto">
                    {{ include('Frontend/themes/default/partials/menu.html.twig', {items: primaryMenu}) }}
                </nav>
            {% endif %}

            <div class="flex items-center gap-4 text-sm">
                {% if accountMenu is not empty %}
                    <nav class="flex items-center gap-3">
                        {{ include('Frontend/themes/default/partials/menu.html.twig', {items: accountMenu}) }}
                    </nav>
                {% endif %}
                {% if context.activeLocales|length > 1 %}
                    {% set localeUrls = {} %}
                    {% for loc in context.activeLocales %}
                        {% set localeUrls = localeUrls|merge({
                            (loc.code): alternatesByLocale[loc.code] ?? default_front_home_path(loc.code),
                        }) %}
                    {% endfor %}
                    {{ include('Frontend/themes/default/partials/locale_switcher.html.twig', {
                        locales: context.activeLocales,
                        current: locale,
                        urls: localeUrls,
                    }) }}
                {% endif %}
            </div>
        </div>
    </header>
    {% endblock %}

    {# Anything that has to span the viewport goes here rather than inside
       <main>, which is width-capped and padded. Escaping that from within with
       `100vw` and a negative margin is the usual trick and the usual bug:
       `100vw` counts the scrollbar, so the page gains a horizontal one. #}
    {% block frontend_banner %}{% endblock %}

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8">
        {% block body %}{% endblock %}
    </main>

    {% block frontend_footer %}
    <footer class="aurora-surface aurora-surface-footer border-t border-line mt-12">
        <div class="max-w-7xl mx-auto px-4 py-6 space-y-4">
            {% if footerMenu is not empty %}
                <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
                    {{ include('Frontend/themes/default/partials/menu.html.twig', {items: footerMenu}) }}
                </nav>
            {% endif %}
            <p class="text-center text-sm text-muted">{{ themeContext.footerText(context.siteName) }}</p>
        </div>
    </footer>
    {% endblock %}
</body>
</html>
