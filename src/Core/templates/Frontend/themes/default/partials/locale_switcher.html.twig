{# Language switcher.

   A flag is a country, not a language — English is not the United Kingdom and
   Portuguese is not Portugal. So the flag is decorative (`aria-hidden`) and the
   language's own name is always in the markup: visible from `sm` up, and read
   out at every width. A switcher a screen reader announces as "image, image"
   is not a switcher.

   `locale_flag()` answers null for a language with no flag mapped, and the
   name alone is then the whole control rather than a gap.

   Expects: `locales` (list of LocaleInterface), `current` (code), `urls`
   (code → href). #}
<nav class="flex items-center gap-1" aria-label="{{ 'shared.locale_switcher'|trans }}">
    {% for loc in locales %}
        {% set isCurrent = loc.code == current %}
        {% set flag = locale_flag(loc.code) %}
        <a
            href="{{ urls[loc.code] }}"
            hreflang="{{ loc.code }}"
            lang="{{ loc.code }}"
            {{ isCurrent ? 'aria-current="true"' : '' }}
            class="flex items-center gap-1.5 px-2 py-1 rounded-md transition-colors {{ isCurrent
                ? 'bg-surface-2 text-primary font-semibold'
                : 'text-secondary hover:text-primary hover:bg-surface-2/60' }}"
        >
            {% if flag %}
                <span class="fi fi-{{ flag }} rounded-[2px] shrink-0" aria-hidden="true"></span>
            {% endif %}
            <span class="sr-only sm:not-sr-only">{{ locale_name(loc.code) ?? loc.code|upper }}</span>
        </a>
    {% endfor %}
</nav>
