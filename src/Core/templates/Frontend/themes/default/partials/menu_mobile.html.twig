{# The same menu, flattened for the phone drawer.

   The hover panel of `menu.html.twig` does not exist under a finger. An entry
   with children was therefore a word that could not be opened, and everything
   it holds stayed out of reach on a phone. Here it becomes a `<details>` that
   expands in place, without waiting on JavaScript, and the branch of the
   current page arrives already open.

   An entry takes its whole row: it is a target aimed at with the thumb, not a
   word in a sentence. The background is only set on the current branch, so
   the list stays a list and not a pile of buttons.

   **An entry that has an address and children keeps both.** The `summary`
   is there to expand, so it cannot lead elsewhere: its own page becomes the
   first row of the fold, otherwise it would only be reachable from a
   computer.

   `isActive` (the branch) and `isCurrent` (the page itself) come from
   MenuRenderer and are not the same thing; see `menu.html.twig`. #}

{% macro rowClass(item) %}
    {%- if item.isActive -%}
        bg-surface-2 text-primary font-medium
    {%- else -%}
        text-secondary hover:bg-surface-2/60 hover:text-primary
    {%- endif -%}
{% endmacro %}

{% import _self as drawer %}

{% for item in items %}
    {% if item.children is empty %}
        <a
            href="{{ item.url }}"
            class="flex items-center rounded-md px-3 py-2.5 transition-colors {{ drawer.rowClass(item) }} {{ item.cssClass }}"
            {% if item.isCurrent %}aria-current="page"{% endif %}
            {% if item.openInNewTab %}target="_blank" rel="noopener"{% endif %}
        >{{ item.label }}</a>
    {% else %}
        <details class="group/entry" {% if item.isActive %}open{% endif %}>
            <summary class="flex cursor-pointer list-none select-none items-center justify-between gap-2 rounded-md px-3 py-2.5 transition-colors [&::-webkit-details-marker]:hidden {{ drawer.rowClass(item) }} {{ item.cssClass }}">
                <span>{{ item.label }}</span>
                {{ include('@Shared/components/icon.html.twig', {
                    name: 'chevron-down',
                    class: 'w-4 h-4 shrink-0 transition-transform group-open/entry:rotate-180',
                    size: 16,
                }) }}
            </summary>

            <div class="ml-3 flex flex-col border-l border-line pl-2">
                {% if item.url %}
                    <a
                        href="{{ item.url }}"
                        class="flex items-center rounded-md px-3 py-2.5 text-secondary transition-colors hover:bg-surface-2/60 hover:text-primary"
                        {% if item.isCurrent %}aria-current="page"{% endif %}
                        {% if item.openInNewTab %}target="_blank" rel="noopener"{% endif %}
                    >{{ 'shared.menu_parent_page'|trans }}</a>
                {% endif %}
                {{ include('Frontend/themes/default/partials/menu_mobile.html.twig', {items: item.children}) }}
            </div>
        </details>
    {% endif %}
{% endfor %}
