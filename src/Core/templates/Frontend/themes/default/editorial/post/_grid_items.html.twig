{# A short list of small things, in one of its costumes.

   `items` comes from GridViewBuilder and carries `display`, `columns` and
   `entries`; the caller has already checked there is at least one entry, so
   nothing here draws an empty frame.

   Four fields serve the eight displays, because they are the same four
   questions asked differently - a step's title is a figure's value is a
   question is a quote's author is a colleague's name. What changes between
   costumes is which of them is loud, which is quiet, and in what order they
   are read.

   Column counts are written out literally: Tailwind only emits classes it can
   read in the source, and `md:grid-cols-{{ n }}` is one it never sees. #}

{% set columns = {
    2: 'sm:grid-cols-2',
    3: 'sm:grid-cols-2 lg:grid-cols-3',
    4: 'sm:grid-cols-2 lg:grid-cols-4',
} %}

<div class="not-prose">
    {% if items.display == 'steps' %}
        {# Numbered, and the number is the point: a process is read in order,
           so it is drawn as an order. The rule down the left is what makes
           three separate boxes read as one sequence. #}
        {# The padding is the room the numbers sit in: 2.5rem of it puts the
           2rem badge astride the rule with a clear 1.5rem left before the
           title starts. It was 1.5rem, which left the badge a twentieth of a
           rem short of the words and reading as one run-on line. #}
        <ol class="m-0 list-none space-y-6 border-l border-line p-0 pl-10">
            {% for entry in items.entries %}
                <li class="relative">
                    <span
                        class="absolute -left-14 flex h-8 w-8 items-center justify-center rounded-full border border-line bg-surface text-sm font-semibold text-accent"
                        aria-hidden="true"
                    >{{ entry.position }}</span>
                    {% if entry.title %}<h3 class="m-0 text-lg font-semibold text-primary">{{ entry.title }}</h3>{% endif %}
                    {% if entry.description %}<p class="mt-1 mb-0 text-secondary">{{ entry.description }}</p>{% endif %}
                </li>
            {% endfor %}
        </ol>

    {% elseif items.display == 'stats' %}
        {# The figure first and large, its meaning under it small: a number
           without its unit says nothing, and a number read after its label
           has already lost the glance it was there to catch. #}
        <dl class="m-0 grid grid-cols-1 gap-6 {{ columns[items.columns] }}">
            {% for entry in items.entries %}
                <div class="aurora-card p-6">
                    {# `data-count-up` porte la valeur finale, et le texte du
                       `<dt>` aussi : le script lit l'une, compte, et repose
                       l'autre. Sans lui - erreur de chargement, JavaScript
                       coupé, moteur de recherche, lecteur d'écran - le chiffre
                       juste est déjà là, écrit par le serveur. Partir de zéro
                       dans le balisage aurait mis un faux chiffre sur la page
                       pour tout ce qui ne joue pas l'animation. #}
                    <dt
                        data-count-up="{{ entry.title }}"
                        class="m-0 text-3xl font-bold text-accent sm:text-4xl"
                    >{{ entry.title }}</dt>
                    {% if entry.description %}<dd class="m-0 mt-1 text-sm text-secondary">{{ entry.description }}</dd>{% endif %}
                </div>
            {% endfor %}
        </dl>

    {% elseif items.display == 'faq' %}
        {# `<details>` rather than a script: it opens without JavaScript, it is
           announced correctly, and a browser's find-in-page reaches inside a
           closed one. The marker is hidden and replaced by a sign that turns,
           because the default triangle cannot be styled across browsers. #}
        {# `name` groups the panels so the browser closes the others itself -
           no script, and it degrades to "several may be open" in a browser
           that does not know the attribute, which is the behaviour every list
           already published has. Scoped to the zone: two lists on one page
           must not close each other's panels. #}
        <div class="divide-y divide-line/40 border-y border-line">
            {% for entry in items.entries %}
                <details
                    class="group py-4"
                    {% if items.exclusiveOpen %}name="fold-{{ items.id }}"{% endif %}
                >
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-primary [&::-webkit-details-marker]:hidden">
                        {{ entry.title }}
                        <span class="shrink-0 text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                    </summary>
                    {% if entry.description %}<p class="mt-3 mb-0 text-secondary">{{ entry.description }}</p>{% endif %}
                </details>
            {% endfor %}
        </div>

    {% elseif items.display == 'timeline' %}
        {# The same rule down the left as the steps above, and deliberately so:
           both are one sequence read in order. What changes is what stands in
           the margin - a number there says "third of five", a date says
           "2024", and a history wants the second. #}
        <ol class="m-0 list-none space-y-8 border-l border-line p-0 pl-10">
            {% for entry in items.entries %}
                <li class="relative">
                    {# A dot rather than a badge: the date is already the
                       marker, and two markers for one entry is one too many. #}
                    <span
                        class="absolute -left-[2.85rem] mt-2 block h-3 w-3 rounded-full border-2 border-accent bg-surface"
                        aria-hidden="true"
                    ></span>
                    {% if entry.caption %}
                        <p class="m-0 text-sm font-semibold uppercase tracking-wider text-accent">{{ entry.caption }}</p>
                    {% endif %}
                    {% if entry.title %}<h3 class="m-0 mt-1 text-lg font-semibold text-primary">{{ entry.title }}</h3>{% endif %}
                    {% if entry.description %}<p class="mt-1 mb-0 text-secondary">{{ entry.description }}</p>{% endif %}
                </li>
            {% endfor %}
        </ol>

    {% elseif items.display == 'offers' %}
        {# What each card has to answer, in the order it is asked: what is this,
           what does it cost, what do I get, how do I start.

           `items-stretch` and `h-full` so the cards of a row share a height -
           three prices at three different heights read as three unrelated
           boxes. The recommended one is lifted rather than made bigger: a card
           that outgrows its neighbours breaks the row it belongs to. #}
        <div class="grid grid-cols-1 items-stretch gap-6 {{ columns[items.columns] }}">
            {% for entry in items.entries %}
                <div class="relative flex h-full flex-col rounded-xl border p-6 {{ entry.featured ? 'border-accent bg-accent-500/5 shadow-lg shadow-black/20' : 'border-line bg-surface' }}">
                    {% if entry.featured %}
                        <span class="absolute -top-3 left-6 rounded-full bg-accent px-3 py-0.5 text-xs font-semibold text-white">
                            {{ 'frontend.editorial.grid.recommended'|trans }}
                        </span>
                    {% endif %}
                    {# The pictogram beside the name rather than over it, at a
                       size that reads as an icon rather than as an
                       illustration. On its own line it pushed the words down
                       and bought nothing: these cards carry a name and a line
                       or two, and a name read next to its sign is read once.
                       `shrink-0` so a long name wraps beside the icon instead
                       of squeezing it, and `object-contain` because a
                       pictogram cropped to a square is a pictogram with its
                       edges cut off. #}
                    <div class="flex items-center gap-3">
                        {% if entry.media %}
                            <img
                                src="{{ entry.media.url }}"
                                alt=""
                                loading="lazy"
                                class="h-10 w-10 shrink-0 object-contain"
                            >
                        {% endif %}
                        {% if entry.title %}<h3 class="m-0 text-lg font-semibold text-primary">{{ entry.title }}</h3>{% endif %}
                    </div>
                    {% if entry.caption %}<p class="m-0 mt-2 text-3xl font-bold text-accent">{{ entry.caption }}</p>{% endif %}
                    {% if entry.description %}
                        {# One line per line, which is how the field is filled
                           in: a list of what is included reads as a list, and
                           asking an author for markup here would be asking for
                           a second editor inside a text box. #}
                        <ul class="m-0 mt-4 flex-1 list-none space-y-2 p-0 text-sm text-secondary">
                            {% for line in entry.description|split('\n') %}
                                {% if line|trim %}
                                    <li class="flex gap-2">
                                        <span class="text-accent" aria-hidden="true">&check;</span>
                                        <span>{{ line|trim }}</span>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if entry.url %}
                        <a
                            href="{{ entry.url }}"
                            class="mt-6 inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium no-underline transition {{ entry.featured ? 'bg-accent text-white hover:opacity-90' : 'border border-accent text-accent hover:bg-accent hover:text-white' }}"
                        >{{ 'frontend.editorial.grid.choose'|trans }}</a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

    {% elseif items.display == 'people' %}
        {# The face first, because that is what the section is for: a reader
           scanning "who are these people" is looking for faces, and a name
           they meet before the portrait is a name they read twice.

           Round, and centred under it the name then the role - the order the
           two are asked in. The quotes costume sets the same three fields
           beside one another because a testimonial is read as a sentence with
           a signature; this one stacks them because a row of colleagues is
           read as a row. #}
        <ul class="m-0 grid list-none grid-cols-1 gap-8 p-0 {{ columns[items.columns] }}">
            {% for entry in items.entries %}
                <li class="m-0 flex flex-col items-center text-center">
                    {% if entry.media %}
                        <img
                            src="{{ entry.media.url }}"
                            alt=""
                            loading="lazy"
                            class="mb-4 h-28 w-28 rounded-full object-cover"
                            style="object-position: {{ entry.media.focalPosition }};"
                        >
                    {% else %}
                        {# The initial, so a card with no portrait yet keeps the
                           height and the rhythm of the ones beside it. A row
                           where one person is 112px shorter than the rest reads
                           as a fault rather than as a missing photograph. #}
                        <span
                            class="mb-4 flex h-28 w-28 items-center justify-center rounded-full border border-line bg-surface text-3xl font-semibold text-muted"
                            aria-hidden="true"
                        >{{ entry.title|slice(0, 1)|upper }}</span>
                    {% endif %}
                    {% if entry.title %}<h3 class="m-0 text-lg font-semibold text-primary">{{ entry.title }}</h3>{% endif %}
                    {% if entry.caption %}
                        <p class="m-0 mt-1 text-sm font-medium uppercase tracking-wider text-accent">{{ entry.caption }}</p>
                    {% endif %}
                    {% if entry.description %}<p class="mt-3 mb-0 text-sm text-secondary">{{ entry.description }}</p>{% endif %}
                    {% if entry.url %}
                        <a href="{{ entry.url }}" rel="noopener" class="mt-3 text-sm text-accent no-underline hover:underline">
                            {{ 'frontend.editorial.grid.get_in_touch'|trans }}
                        </a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>

    {% elseif items.display == 'quotes' %}
        {# The quote before the name, which is the order it is read in, and a
           `<blockquote>` because that is what it is. #}
        <div class="grid grid-cols-1 gap-6 {{ columns[items.columns] }}">
            {% for entry in items.entries %}
                <figure class="aurora-card m-0 flex h-full flex-col p-6">
                    {% if entry.description %}
                        <blockquote class="m-0 flex-1 border-0 p-0 text-secondary not-italic">{{ entry.description }}</blockquote>
                    {% endif %}
                    <figcaption class="mt-4 flex items-center gap-3">
                        {% if entry.media %}
                            <img
                                src="{{ entry.media.url }}"
                                alt=""
                                loading="lazy"
                                class="h-10 w-10 shrink-0 rounded-full object-cover"
                                style="object-position: {{ entry.media.focalPosition }};"
                            >
                        {% endif %}
                        <span class="min-w-0">
                            {% if entry.title %}<span class="block truncate font-medium text-primary">{{ entry.title }}</span>{% endif %}
                            {% if entry.caption %}<span class="block truncate text-sm text-muted">{{ entry.caption }}</span>{% endif %}
                        </span>
                    </figcaption>
                </figure>
            {% endfor %}
        </div>

    {% else %}
        {# Logos. Muted until hovered, so a row of client marks reads as one
           band rather than as a dozen competing colours. The name is the alt
           text, which is what a screen reader has to go on. #}
        <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-x-10 gap-y-6 p-0">
            {% for entry in items.entries %}
                <li class="m-0">
                    {% set logo %}
                        {% if entry.media %}
                            <img
                                src="{{ entry.media.url }}"
                                alt="{{ entry.title }}"
                                loading="lazy"
                                class="h-8 w-auto opacity-60 grayscale transition duration-200 hover:opacity-100 hover:grayscale-0 sm:h-10"
                            >
                        {% else %}
                            <span class="text-sm font-medium text-muted transition-colors hover:text-primary">{{ entry.title }}</span>
                        {% endif %}
                    {% endset %}
                    {% if entry.url %}
                        <a href="{{ entry.url }}" rel="noopener" class="block no-underline">{{ logo }}</a>
                    {% else %}
                        {{ logo }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
