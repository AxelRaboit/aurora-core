{# An index: the letters that have entries across the top, as anchors, then
   one group per letter. Letters with nothing under them are not printed -
   a bar of twenty-six where eleven lead anywhere is a bar of dead ends. #}
<nav class="not-prose" aria-labelledby="{{ zone.id }}-index">
    <p id="{{ zone.id }}-index" class="sr-only">{{ 'frontend.editorial.grid.index.label'|trans }}</p>
    <ul class="m-0 mb-6 flex list-none flex-wrap gap-1.5 p-0">
        {% for group in zone.postList.index %}
            <li><a href="#{{ zone.id }}-{{ group.letter == '#' ? 'other' : group.letter }}" class="flex h-8 min-w-8 items-center justify-center rounded-md border border-line px-2 text-sm font-semibold text-primary no-underline hover:border-accent hover:text-accent">{{ group.letter }}</a></li>
        {% endfor %}
    </ul>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for group in zone.postList.index %}
            <section id="{{ zone.id }}-{{ group.letter == '#' ? 'other' : group.letter }}" class="scroll-mt-24">
                <h3 class="m-0 mb-2 border-b border-line pb-1 text-lg font-bold text-accent">{{ group.letter }}</h3>
                <ul class="m-0 list-none space-y-1 p-0 text-sm">
                    {% for entry in group.entries %}
                        <li><a href="{{ entry.url }}" class="text-primary no-underline hover:text-accent">{{ entry.title }}</a></li>
                    {% endfor %}
                </ul>
            </section>
        {% endfor %}
    </div>
</nav>
