{# A rating up front, then a few of the most recent reviews - each one a
   quote from someone real, on the platform they actually wrote it. The
   link at the end is Google's own review page, not a form of this site's. #}
<div class="not-prose">
    <div class="mb-5 flex flex-wrap items-center gap-3">
        <span class="flex" aria-hidden="true">
            {% for i in 1..5 %}
                <svg viewBox="0 0 20 20" class="h-5 w-5 {{ i <= zone.googleReviews.rating ? 'fill-amber-400' : 'fill-line' }}"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6z"/></svg>
            {% endfor %}
        </span>
        <span class="text-lg font-semibold text-primary">{{ zone.googleReviews.ratingLabel }}</span>
        <a href="{{ zone.googleReviews.url }}" target="_blank" rel="noopener" class="text-sm text-secondary no-underline hover:text-highlight">{{ 'frontend.editorial.grid.reviews.count'|trans({'%count%': zone.googleReviews.total}) }}</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
        {% for review in zone.googleReviews.reviews|slice(0, 4) %}
            <blockquote class="m-0 rounded-xl border border-line bg-surface p-4">
                <div class="mb-2 flex items-center gap-2">
                    {% if review.photo %}
                        <img src="{{ review.photo }}" alt="" loading="lazy" class="h-8 w-8 rounded-full object-cover">
                    {% endif %}
                    <div class="min-w-0">
                        <p class="m-0 truncate text-sm font-semibold text-primary">{{ review.author }}</p>
                        <p class="m-0 text-xs text-muted">{{ review.relativeTime }}</p>
                    </div>
                </div>
                <p class="m-0 line-clamp-4 text-sm text-secondary">{{ review.text }}</p>
            </blockquote>
        {% endfor %}
    </div>
    <a href="{{ zone.googleReviews.url }}" target="_blank" rel="noopener" class="mt-4 inline-block text-sm text-accent no-underline hover:underline">{{ 'frontend.editorial.grid.reviews.write'|trans }}</a>
</div>
