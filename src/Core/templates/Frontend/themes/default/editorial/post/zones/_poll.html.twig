{# A question and its answers as buttons. poll.js sends the answer and swaps
   the buttons for the results; a reader who has voted here before sees the
   results straight away. Without the script the buttons are inert and the
   question still reads - which is the honest fallback for a vote that needs
   the server. #}
<section
    class="not-prose rounded-xl border border-line bg-surface p-5"
    data-poll
    {% if widget.endpoint %}data-poll-endpoint="{{ widget.endpoint }}"{% endif %}
    data-poll-key="{{ widget.zoneKey }}"
    data-poll-total-label="{{ 'frontend.editorial.grid.poll.total'|trans({'%count%': '__count__'}) }}"
>
    <p class="m-0 mb-4 text-base font-semibold text-primary">{{ widget.question }}</p>
    <ul class="m-0 list-none space-y-2 p-0">
        {% for answer in widget.answers %}
            <li>
                <button
                    type="button"
                    class="relative block w-full overflow-hidden rounded-lg border border-line px-4 py-2.5 text-left text-sm text-primary transition-colors hover:border-accent disabled:cursor-default disabled:hover:border-line"
                    data-poll-answer="{{ answer.index }}"
                    {{ widget.showResults ? 'disabled' : '' }}
                >
                    <span class="absolute inset-y-0 left-0 bg-accent-500/15 transition-[width] duration-500{{ widget.showResults ? '' : ' hidden' }}" style="width: {{ answer.percent }}%;" data-poll-bar></span>
                    <span class="relative flex items-center justify-between gap-3">
                        <span>{{ answer.label }}</span>
                        <span class="tabular-nums text-muted{{ widget.showResults ? '' : ' hidden' }}" data-poll-percent>{{ answer.percent }} %</span>
                    </span>
                </button>
            </li>
        {% endfor %}
    </ul>
    <p class="m-0 mt-3 text-xs text-muted{{ widget.showResults ? '' : ' hidden' }}" data-poll-total>{{ 'frontend.editorial.grid.poll.total'|trans({'%count%': widget.total}) }}</p>
</section>
