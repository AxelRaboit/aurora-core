{% extends 'Frontend/themes/default/layout.html.twig' %}

{% block seo_define %}
    {% do seo({
        title: translationData.metaTitle ?: translationData.title,
        description: translationData.metaDescription ?: translationData.description,
        image: translationData.ogImage.publicUrl|default(null),
        canonical: translationData.canonicalUrl ?: (translationData.slug
            ? path('editorial_post', {locale: locale, postTypeSlug: postData.postType.slug, slug: translationData.slug})
            : ''),
        type: 'article',
        noindex: translationData.noindex,
        jsonLd: translationData.jsonLd,
    }) %}
{% endblock %}

{# A full-width banner renders above <main>, which is where the layout leaves
   room for anything that has to span the viewport. Inside <main> it would be
   capped by max-w-7xl and inset by its padding. #}
{% block frontend_banner %}
    {% if banner and banner.width starts with 'full' %}
        {{ include('Frontend/themes/default/editorial/post/_banner.html.twig', {banner: banner}) }}
    {% endif %}
{% endblock %}

{% block body %}
<article class="prose max-w-none">
    {% if banner and not (banner.width starts with 'full') %}
        {{ include('Frontend/themes/default/editorial/post/_banner.html.twig', {banner: banner}) }}
    {% endif %}

    {# The banner carries its own title and description, so repeating the
       plain header under it would print everything twice. A post without a
       banner keeps the header it always had. #}
    {% if not banner %}
        <h1>{{ translationData.title }}</h1>

        {% if translationData.description %}
            <p class="lead text-secondary">{{ translationData.description }}</p>
        {% endif %}
    {% endif %}

    {% if featuredMediaData %}
        <img
            src="{{ featuredMediaData.url }}"
            alt="{{ featuredMediaData.alt ?? '' }}"
            class="w-full rounded-xl"
            style="object-position: {{ featuredMediaData.focalPosition }};"
        >
    {% endif %}

    {# Already HTML: BlocksRenderer escaped and sanitised every value on the
       way out, so escaping again here would print the markup. #}
    {{ content|raw }}

    {% if terms is not empty %}
        <footer class="flex flex-wrap gap-1.5 not-prose border-t border-line pt-4 mt-8">
            {% for taxonomySlug, names in terms %}
                {% for name in names %}
                    <span class="px-2 py-0.5 text-xs rounded-md bg-surface-2 text-secondary">{{ name }}</span>
                {% endfor %}
            {% endfor %}
        </footer>
    {% endif %}
</article>

{% if commentsEnabled|default(false) %}
    <section {{ vue_component('editorial/frontend/PostComments', {
        listPath: path('editorial_post_comments', {locale: locale, postTypeSlug: postData.postTypeSlug, slug: translationData.slug}),
        submitPath: path('editorial_post_comment_submit', {locale: locale, postTypeSlug: postData.postTypeSlug, slug: translationData.slug}),
        reactPathTemplate: path_template('editorial_comment_react', {locale: locale, postTypeSlug: postData.postTypeSlug, slug: translationData.slug, commentId: '__commentId__'}),
    }) }} class="mt-12 not-prose"></section>
{% endif %}
{% endblock %}
