{# Read through a link, the page extends a layout of its own instead of the
   site's: no menu, no footer of links, a header that says who it was prepared
   for. Everything else is this same template, so the two cannot drift. #}
{% extends readingLayout|default(null) ?: 'Frontend/themes/default/layout.html.twig' %}

{# Les classes qui portent l'accent et les survols de la publication, posées
   ici, hors de tout bloc, pour que la mise en page les lise aussi : l'entête
   pleine largeur les prend toujours, la topbar et le pied seulement quand la
   publication le demande (« Topbar et pied de page aux couleurs de la page »).
   Une classe sans règle ne change rien : la règle n'est émise, plus bas, que
   pour une couleur valide. #}
{% set pageColorClass = ((postData.accentColor|default(null) ? 'aurora-post-accent' : '') ~ (postData.highlight|default(null) ? ' aurora-post-highlight' : ''))|trim %}
{% set chromeClass = postData.chromeFollowsPage|default(false) ? pageColorClass : '' %}

{% block seo_define %}
    {# Read through a link, there is no address on the site to name as
       canonical: for a publication shared by link that page answers 404. #}
    {% do seo({
        title: translationData.metaTitle ?: translationData.title,
        description: translationData.metaDescription ?: translationData.description,
        image: translationData.ogImage.publicUrl|default(null),
        imageAlt: translationData.ogImage.alt|default(null),
        canonical: reading|default(null) ? '' : (translationData.canonicalUrl ?: (translationData.slug
            ? path('editorial_post', {locale: locale, postTypeSlug: postData.postType.slug, slug: translationData.slug})
            : '')),
        type: 'article',
        noindex: translationData.noindex,
        jsonLd: translationData.jsonLd,
    }) %}
{% endblock %}

{# A full-width banner renders above <main>, which is where the layout leaves
   room for anything that has to span the viewport. Inside <main> it would be
   capped by max-w-7xl and inset by its padding. #}
{% block frontend_banner %}
    {% if banner and banner.width starts with 'full' %}
        {# Hors de <article>, donc enveloppé : sans ces classes il gardait
           l'accent du thème au-dessus d'une page qui en avait choisi un autre.
           La couleur propre au bandeau ou à une diapositive, posée en style
           sur l'élément, passe toujours devant. #}
        <div{% if pageColorClass %} class="{{ pageColorClass }}"{% endif %}>
            {{ include('Frontend/themes/default/editorial/post/_banner.html.twig', {banner: banner}) }}
        </div>
    {% endif %}
{% endblock %}

{% block body %}
{# Scoped to the publication's own elements rather than `:root`: choosing
   ocre for the photography page repaints the topbar and the footer only when
   the page asks for it (`chromeClass`, at the top of this file). The
   full-width banner, outside <article>, carries the same class. #}
{% if postData.accentColor|default(null) %}
    <style>{{ themeStyles.postAccentCss('.aurora-post-accent', postData.accentColor)|raw }}</style>
{% endif %}

{# Même portée pour les survols : la topbar et le pied gardent ceux du thème,
   sauf quand la publication les entraîne avec elle. #}
{% set postHighlightCss = themeStyles.postHighlightCss('.aurora-post-highlight', postData.highlight|default(null), postData.highlightColor|default(null)) %}
{% if postHighlightCss %}
    <style>{{ postHighlightCss|raw }}</style>
{% endif %}

<article class="prose max-w-none{{ postData.accentColor|default(null) ? ' aurora-post-accent' : '' }}{{ postHighlightCss ? ' aurora-post-highlight' : '' }}">
    {% if banner and not (banner.width starts with 'full') %}
        {{ include('Frontend/themes/default/editorial/post/_banner.html.twig', {banner: banner}) }}
    {% endif %}

    {# The banner carries its own title, so repeating the plain header under it
       would print everything twice - but only when it actually carries one. A
       purely decorative banner leaves the page without any heading, so the
       plain header stays. #}
    {% if not banner or banner.headingIndex is null %}
        {# `titleVisible` hides the pair from sight, never from the document.
           The heading stays in the markup as `sr-only` because it is the page's
           only `<h1>` in this branch - the banner has none, and a grid text
           zone cannot make one, its editor offers levels 2 to 4. Dropping the
           element outright would leave the document with no first-level
           heading at all, and its highest heading an h2: a structure that reads
           as a fragment to a screen reader and to a crawler alike. Hidden is a
           layout decision; absent would be a different document. #}
        {# `??` and not `|default`: the default filter falls back on any *empty*
           value, and `false` is empty - so `titleVisible|default(true)` was
           true whichever way the switch was set, and the flag could never turn
           anything off. `??` falls back only on null or undefined. #}
        {% set showTitle = titleVisible ?? true %}

        {# `mb-3` only when a summary follows, and `mt-0` on the summary itself.
           Both are needed: adjacent vertical margins collapse to the larger, so
           shrinking the paragraph alone would have left `prose`'s 32px on the
           heading and changed nothing.

           The pair was reading backwards - 32px above the summary against 20px
           below it, so it sat closer to the section that follows than to the
           title it belongs to. Twelve puts it back where it belongs without
           crowding a 36px heading. #}
        {% set hasSummary = showTitle and translationData.description %}

        <h1 class="{{ showTitle ? '' : 'sr-only' }}{{ hasSummary ? ' mb-3' : '' }}">{{ translationData.title }}</h1>

        {# No size class at all, rather than the typography plugin's `lead`
           (1.25em, so 20px) or a `text-base`. The summary is meant to read as
           an ordinary paragraph, and the way to get that is to let `prose`
           style it as one: 16px over a 28px line. `text-base` would pin the
           size and bring its own 24px line-height, so it would match the body
           text in size and not in rhythm. Colour is the only thing that sets
           this paragraph apart.

           The summary is dropped rather than hidden: nothing in the document's
           structure depends on it, and the meta description - which is what a
           crawler reads - is a field of its own. #}
        {% if hasSummary %}
            <p class="mt-0 text-secondary">{{ translationData.description }}</p>
        {% endif %}

        {# Zero means nothing to time - a post with no grid at all - and the
           template says nothing rather than printing "0 min de lecture". #}
        {% if readingTimeMinutes %}
            <p class="mt-0 text-sm text-muted not-prose">
                {{ 'frontend.editorial.reading_time'|trans({'%minutes%': readingTimeMinutes}) }}
            </p>
        {% endif %}
    {% endif %}

    {# The thumbnail is not printed here any more. It is what stands for this
       publication in a listing, and the custom header is what opens the page -
       rendering both put two hero images one above the other. #}

    {# The body, and the only one there is. The plain block column that used to
       sit in an `{% else %}` here was migrated into a one-zone grid, and the
       `content` variable that fed it is no longer passed at all - keeping it
       would have meant a second path nobody exercised, quietly rotting until
       the day something fell back to it and rendered words a year out of date.

       Null when the post has no grid, which now means it has no body: an
       author who has laid out nothing gets nothing here, rather than an empty
       wrapper pretending to be content. #}
    {% if grid %}
        {{ include('Frontend/themes/default/editorial/post/_grid.html.twig', {grid: grid, locale: locale}) }}
    {% endif %}

    {# Under the grid, which is where a gallery belongs by default: the words
       first, the pictures after. Null when there is no gallery, so a post
       without one gets nothing rather than an empty section. #}
    {% if gallery %}
        {# L'effet de la page voyage jusqu'ici : une galerie n'est pas une zone
           de grille et n'a donc pas de réglage à elle, mais elle appartient à
           la publication et doit arriver comme le reste. #}
        {{ include('Frontend/themes/default/editorial/post/_gallery.html.twig', {gallery: gallery, reveal: grid.reveal|default('none')}) }}
    {% endif %}

    {# Null for every type that is not read in sequence, which is all of them
       but the documentation: a blog article gets nothing rather than an empty
       nav. #}
    {% if sequence %}
        {{ include('Frontend/themes/default/editorial/post/_sequence.html.twig', {sequence: sequence}) }}
    {% endif %}
</article>

{# The foot of the page: what it is filed under, where else to go, and how to
   pass it on. One rule over the three rather than one each, and every row
   opens with a word that says what it holds - « Compétences », « Liens
   utiles », « Partager » - so they read as one block rather than three
   strips of chips. A share list emptied on purpose is not a row. #}
{% set usefulLinks = usefulLinks|default([]) %}
{% set shareShown = (shareEnabled ?? true) and ((shareLinks ?? null) is null or shareLinks is not empty) %}
{% if terms is not empty or usefulLinks is not empty or shareShown %}
    <footer class="not-prose mt-8 space-y-3 border-t border-line pt-4">
        {% for taxonomySlug, group in terms %}
            <div class="flex flex-wrap items-center gap-2">
                {% if group.label %}<span class="text-sm text-secondary">{{ group.label }}</span>{% endif %}
                {% for name in group.names %}
                    <span class="inline-flex items-center rounded-md border border-line px-2.5 py-1.5 text-sm text-secondary">{{ name }}</span>
                {% endfor %}
            </div>
        {% endfor %}

        {% if usefulLinks is not empty %}
            {{ include('Frontend/themes/default/editorial/post/_useful_links.html.twig', {links: usefulLinks}) }}
        {% endif %}

        {# The reader's own address, resolved once by `seo_define` above and
           read back here rather than rebuilt: two computations of the same
           canonical URL is two places that could disagree about it. #}
        {% if shareShown %}
            <div {{ vue_component('editorial/frontend/ShareButtons', {
                url: seo_current().canonical,
                title: translationData.title,
                links: shareLinks ?? null,
            }) }}></div>
        {% endif %}
    </footer>
{% endif %}

{# Quiet when the grid has placed the thread itself: one conversation per
   page, where the author put it. #}
{% if commentsEnabled|default(false) and not (grid.hasComments|default(false)) %}
    <section {{ vue_component('editorial/frontend/PostComments', {
        listPath: path('editorial_post_comments', {locale: locale, postTypeSlug: postData.postTypeSlug, slug: translationData.slug}),
        submitPath: path('editorial_post_comment_submit', {locale: locale, postTypeSlug: postData.postTypeSlug, slug: translationData.slug}),
        reactPathTemplate: path_template('editorial_comment_react', {locale: locale, postTypeSlug: postData.postTypeSlug, slug: translationData.slug, commentId: '__commentId__'}),
        captcha: public_captcha(),
    }) }} class="mt-12 not-prose"></section>
{% endif %}
{% endblock %}
