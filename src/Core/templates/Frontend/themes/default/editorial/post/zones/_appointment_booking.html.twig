{# A day, then a time, then a name and an email: three steps, one at a time,
   so a phone never shows more than one decision at once. bookingForm.js
   drives the steps and posts the choice; without it the days and slots stay
   listed, plain, one under another. #}
<section class="not-prose rounded-xl border border-line bg-surface p-5" data-booking data-booking-endpoint="{{ widget.endpoint }}">
    {% if widget.title %}<p class="m-0 mb-1 text-base font-semibold text-primary">{{ widget.title }}</p>{% endif %}
    {% if widget.note %}<p class="m-0 mb-4 text-sm text-secondary">{{ widget.note }}</p>{% endif %}

    {% if widget.days is empty %}
        <p class="m-0 text-sm text-muted">{{ 'frontend.editorial.grid.booking.none'|trans }}</p>
    {% else %}
        <div class="flex gap-2 overflow-x-auto pb-2" data-booking-days role="tablist">
            {% for day in widget.days %}
                <button type="button" class="shrink-0 rounded-lg border border-line px-3 py-2 text-sm text-primary data-[active]:border-accent data-[active]:bg-accent-500/10" data-booking-day="{{ day.date }}"{{ loop.first ? ' data-active' : '' }}>{{ day.label }}</button>
            {% endfor %}
        </div>

        {% for day in widget.days %}
            <div class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-4" data-booking-slots="{{ day.date }}"{{ loop.first ? '' : ' hidden' }}>
                {% for slot in day.slots %}
                    <button type="button" class="rounded-lg border border-line px-2 py-2 text-sm tabular-nums text-primary hover:border-highlight" data-booking-slot="{{ slot.at }}">{{ slot.label }}</button>
                {% endfor %}
            </div>
        {% endfor %}

        <form class="mt-5 hidden space-y-3 border-t border-line pt-5" data-booking-form>
            <p class="m-0 text-sm font-medium text-primary" data-booking-chosen></p>
            <div class="grid gap-3 sm:grid-cols-2">
                <input type="text" required autocomplete="name" placeholder="{{ 'frontend.editorial.grid.booking.name'|trans }}" class="w-full rounded-lg border border-line bg-transparent px-3 py-2 text-sm text-primary" data-booking-name>
                <input type="email" required autocomplete="email" placeholder="{{ 'frontend.editorial.grid.booking.email'|trans }}" class="w-full rounded-lg border border-line bg-transparent px-3 py-2 text-sm text-primary" data-booking-email>
                <input type="tel" autocomplete="tel" placeholder="{{ 'frontend.editorial.grid.booking.phone'|trans }}" class="w-full rounded-lg border border-line bg-transparent px-3 py-2 text-sm text-primary sm:col-span-2" data-booking-phone>
                <textarea rows="3" placeholder="{{ 'frontend.editorial.grid.booking.message'|trans }}" class="w-full rounded-lg border border-line bg-transparent px-3 py-2 text-sm text-primary sm:col-span-2" data-booking-message></textarea>
            </div>
            <p class="m-0 hidden text-sm text-rose-500" data-booking-error data-taken="{{ 'frontend.editorial.grid.booking.taken'|trans }}" data-invalid="{{ 'frontend.editorial.grid.booking.invalid'|trans }}"></p>
            <button type="submit" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90" data-booking-submit>{{ 'frontend.editorial.grid.booking.confirm'|trans }}</button>
        </form>
        <p class="mt-5 hidden text-sm font-medium text-emerald-600" data-booking-success data-template="{{ 'frontend.editorial.grid.booking.success'|trans }}"></p>
    {% endif %}
</section>
