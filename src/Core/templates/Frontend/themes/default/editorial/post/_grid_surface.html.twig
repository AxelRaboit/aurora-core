{# What a zone sits on, and whether it takes the whole screen to do it.

   A macro rather than an include because it wraps rather than renders: the
   caller hands over the zone and its already-built markup, and gets it back
   inside whatever surface the zone asked for. Both callers need it - a leaf
   zone in `_grid_zone.html.twig` and a stack in `_grid.html.twig` - and a
   background that a stack could not have would leave the one arrangement a
   call to action is made of, a title and a line and a button in one band, as
   three zones with nothing holding them together.

   Written out literally rather than assembled: Tailwind only emits classes it
   can read in the source, and `bg-{{ surface }}` is one it never sees. #}

{# `custom` carries its own colour, gradient or picture - resolved server-side
   into `zone.background.fillStyle`/`media`/`overlay` by GridViewBuilder, the
   same split BannerViewBuilder makes for the banner. The three maps below
   still need an entry for it: the shape (rounded corners, padding, the
   `isolate` a picture needs to sit behind) is Tailwind, only the colour is
   inline. #}
{% macro backdrop(zone) %}
    {% if zone.background is not null and zone.background.media %}
        <img
            src="{{ zone.background.media.url }}"
            alt=""
            aria-hidden="true"
            class="absolute inset-0 -z-10 h-full w-full object-cover"
            style="object-position: {{ zone.background.media.focalPosition }};"
        >
        {% if zone.background.overlay > 0 %}
            <div class="absolute inset-0 -z-10 bg-black" style="opacity: {{ zone.background.overlay / 100 }};"></div>
        {% endif %}
    {% endif %}
{% endmacro %}

{% macro wrap(zone, body) %}
    {% import _self as this %}
    {% set surfaces = {
        none: '',
        card: 'rounded-xl border border-line bg-surface p-6 sm:p-8',
        soft: 'rounded-xl bg-surface-2 p-6 sm:p-8',
        accent: 'rounded-xl border border-accent-500/30 bg-accent-500/10 p-6 sm:p-8',
        custom: 'relative isolate overflow-hidden rounded-xl p-6 sm:p-8',
    } %}
    {# Across the viewport the corners go: a band with rounded ends reads as a
       very wide card that has overflowed, which is not what it is. #}
    {% set bleedSurfaces = {
        none: '',
        card: 'border-y border-line bg-surface py-10 sm:py-14',
        soft: 'bg-surface-2 py-10 sm:py-14',
        accent: 'border-y border-accent-500/30 bg-accent-500/10 py-10 sm:py-14',
        custom: 'relative isolate overflow-hidden py-10 sm:py-14',
    } %}
    {% set surface = zone.surface|default('none') %}

    {# A picture alone on a surface is framed by it, so the padding goes: the
       card *is* the frame, and a photograph inset by two centimetres of
       background reads as a picture that failed to fill its box.

       A picture with a caption or a credit keeps the padding, because those
       are words and words must not touch an edge. The zone knows which it is,
       which is why the question is asked here rather than left to the author. #}
    {% set framed = zone.type == 'media' and not zone.caption and not (zone.media.credit|default(null)) %}
    {% set frames = {
        none: '',
        card: 'overflow-hidden rounded-xl border border-line bg-surface',
        soft: 'overflow-hidden rounded-xl bg-surface-2',
        accent: 'overflow-hidden rounded-xl border border-accent-500/30 bg-accent-500/10',
        custom: 'relative isolate overflow-hidden rounded-xl',
    } %}

    {# Read once: built from validated hex colours by GridViewBuilder, so
       `raw` here is not a hole - same reasoning as the banner's own style. #}
    {% set customStyle = surface == 'custom' ? zone.background.fillStyle|default('') : '' %}

    {% if zone.fullBleed|default(false) %}
        {# Viewport units and a negative margin rather than `100vw`, which
           counts the scrollbar and hands the page a horizontal one.

           A picture is the content and spans edge to edge; anything else is
           words, and words at the width of a screen are unreadable - so
           everything but a picture is held to the same box `<main>` uses. #}
        <div class="w-screen max-w-none relative left-1/2 -translate-x-1/2 {{ bleedSurfaces[surface] }}"{% if customStyle %} style="{{ customStyle|raw }}"{% endif %}>
            {{ this.backdrop(zone) }}
            {% if zone.type == 'media' %}
                {{ body }}
            {% else %}
                <div class="mx-auto w-full max-w-7xl px-4">{{ body }}</div>
            {% endif %}
        </div>
    {% elseif surface != 'none' %}
        <div class="{{ framed ? frames[surface] : surfaces[surface] }}"{% if customStyle %} style="{{ customStyle|raw }}"{% endif %}>
            {{ this.backdrop(zone) }}
            {{ body }}
        </div>
    {% else %}
        {{ body }}
    {% endif %}
{% endmacro %}
