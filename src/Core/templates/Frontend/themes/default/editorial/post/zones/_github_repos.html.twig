{# A card per repository: name, description, language, stars and forks, and
   when it last moved - the four things a visitor weighs a project by. #}
<div class="not-prose grid gap-4 sm:grid-cols-2">
    {% for repository in zone.githubActivity.repos %}
        <a href="{{ repository.url }}" rel="noopener" class="group flex flex-col gap-2 rounded-xl border border-card-line bg-surface p-4 no-underline transition-colors hover:border-highlight">
            <span class="text-sm font-semibold text-primary group-hover:text-highlight">{{ repository.fullName }}</span>
            {% if repository.description %}
                <span class="text-sm text-secondary">{{ repository.description }}</span>
            {% endif %}
            <span class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-1 text-xs text-muted">
                {% if repository.language %}<span>{{ repository.language }}</span>{% endif %}
                <span>★ {{ repository.starsLabel }}</span>
                <span>⑂ {{ repository.forksLabel }}</span>
                {% if repository.updatedLabel %}<span>{{ repository.updatedLabel }}</span>{% endif %}
            </span>
        </a>
    {% endfor %}
</div>
