{# A card per repository: name, description, language, stars and forks, and
   when it last moved - the four things a visitor weighs a project by. #}
<div class="not-prose grid gap-4 sm:grid-cols-2">
    {% for repo in zone.githubActivity.repos %}
        <a href="{{ repo.url }}" rel="noopener" class="group flex flex-col gap-2 rounded-xl border border-line bg-surface p-4 no-underline transition-colors hover:border-highlight">
            <span class="text-sm font-semibold text-primary group-hover:text-highlight">{{ repo.fullName }}</span>
            {% if repo.description %}
                <span class="text-sm text-secondary">{{ repo.description }}</span>
            {% endif %}
            <span class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-1 text-xs text-muted">
                {% if repo.language %}<span>{{ repo.language }}</span>{% endif %}
                <span>★ {{ repo.starsLabel }}</span>
                <span>⑂ {{ repo.forksLabel }}</span>
                {% if repo.updatedLabel %}<span>{{ repo.updatedLabel }}</span>{% endif %}
            </span>
        </a>
    {% endfor %}
</div>
