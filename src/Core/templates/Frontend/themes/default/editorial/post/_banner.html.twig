{# Post banner — rendered above the article when the translation configures one.
   `banner` comes from BannerViewBuilder and is null when disabled or empty, so
   the caller guards on it rather than this file second-guessing.

   Items lay out on the shared 48-column grid (`.aurora-grid`, see
   css/base/aurora-grid.css). Each one carries its width as custom properties
   rather than classes: a span is a runtime number, and Tailwind only emits
   classes it can read in the source.

   The height and alignment maps below are written out literally for the same
   reason — a class assembled by concatenation is one Tailwind never sees. #}

{% set heights = {
    sm: 'min-h-48',
    md: 'min-h-72',
    lg: 'min-h-[32rem]',
    full: 'min-h-screen',
} %}

{% set alignments = {
    start: 'text-left items-start',
    center: 'text-center items-center',
    end: 'text-right items-end',
} %}

{% set verticals = {
    start: 'justify-start',
    center: 'justify-center',
    end: 'justify-end',
} %}

{% set titleSizes = {
    sm: 'text-xl sm:text-2xl',
    md: 'text-3xl sm:text-4xl',
    lg: 'text-4xl sm:text-5xl',
    xl: 'text-5xl sm:text-6xl',
} %}

{# Three placements:
   - contained    — the banner sits in the article column, rounded like a card
   - full_aligned — background spans the viewport, content keeps the page's
                    own left edge, so the title lines up with the text below
   - full         — background and content both span, edge to edge

   The two full modes drop the rounding: a corner radius against the window
   edge reads as a mistake.

   `full_aligned` mirrors <main>'s own box — max-w-7xl, centred, px-4 — rather
   than guessing a value, so the two stay aligned if that ever changes. #}
{% set isFull = banner.width starts with 'full' %}

{% set contentBox = {
    contained: 'p-8 sm:p-12',
    full_aligned: 'w-full max-w-7xl mx-auto px-4 py-8 sm:py-12',
    full: 'p-8 sm:p-12 lg:px-16',
} %}

<header
    {# flex column, so the inner grid can claim the leftover height. `h-full`
       on it would not: the header's own height is auto, and a percentage
       height against min-height resolves to nothing. #}
    class="relative isolate flex flex-col overflow-hidden not-prose {{ heights[banner.height] }} {{ isFull ? 'mb-8' : 'rounded-xl mb-8' }}"
    {# Already a CSS declaration built from hex-validated parts by
       BannerViewBuilder, so `raw` here is not a hole. #}
    {% if banner.background.fillStyle %}style="{{ banner.background.fillStyle|raw }}"{% endif %}
>
    {% if banner.background.media %}
        <img
            src="{{ banner.background.media.url }}"
            alt=""
            aria-hidden="true"
            class="absolute inset-0 -z-10 h-full w-full object-cover"
            style="object-position: {{ banner.background.media.focalPosition }};"
        >
        {% if banner.background.overlay > 0 %}
            {# Darkens the picture so item text stays readable over it. #}
            <div class="absolute inset-0 -z-10 bg-black" style="opacity: {{ banner.background.overlay / 100 }};"></div>
        {% endif %}
    {% endif %}

    {% if banner.logo %}
        <img src="{{ banner.logo.url }}" alt="{{ banner.logo.alt }}" class="absolute top-6 left-6 z-10 h-10 w-auto">
    {% endif %}

    {# Row gap only. The column axis belongs to `.aurora-grid`, which spaces
       items with padding: a column-gap here would be 47 gutters across the 48
       tracks and push the last item out of the banner. #}
    <div class="aurora-grid flex-1 gap-y-8 {{ contentBox[banner.width] }}">
        {% for item in banner.items %}
            <div style="{{ item.spanStyle|raw }}">
                {% if item.type == 'text' %}
                    <div class="flex h-full flex-col gap-3 {{ verticals[banner.verticalAlign] }} {{ alignments[item.align] }}">
                        {% if item.title %}
                            {# The first title carries the page's <h1>; the rest
                               are paragraphs. A banner that replaces the header
                               has to replace its heading too. #}
                            {% set titleTag = loop.index0 == banner.headingIndex ? 'h1' : 'p' %}
                            <{{ titleTag }}
                                class="{{ titleSizes[item.titleSize] }} font-bold leading-tight"
                                {% if item.titleColor %}style="color: {{ item.titleColor }};"{% endif %}
                            >{{ item.title }}</{{ titleTag }}>
                        {% endif %}
                        {% if item.description %}
                            <p class="text-base sm:text-lg max-w-prose"
                               {% if item.descriptionColor %}style="color: {{ item.descriptionColor }};"{% endif %}
                            >{{ item.description }}</p>
                        {% endif %}
                    </div>
                {% elseif item.type == 'button' and item.label and item.url %}
                    {# Both the label and a link that survived the whitelist are
                       required: a button with neither is a dead control, and
                       one with no destination is worse than absent. #}
                    <div class="flex h-full flex-col gap-3 {{ verticals[banner.verticalAlign] }} {{ alignments[item.align] }}">
                        <a
                            href="{{ item.url }}"
                            class="inline-flex items-center justify-center rounded-lg px-6 py-3 font-medium transition-opacity hover:opacity-90 no-underline"
                            style="
                                background-color: {{ item.buttonColor ?? '#ffffff' }};
                                color: {{ item.buttonTextColor ?? '#0f172a' }};
                            "
                        >{{ item.label }}</a>
                    </div>
                {% elseif item.type == 'image' and item.media %}
                    <div class="flex h-full items-center justify-center">
                        <img
                            src="{{ item.media.url }}"
                            alt="{{ item.media.alt }}"
                            class="max-h-full w-full rounded-lg object-cover"
                            style="object-position: {{ item.media.focalPosition }};"
                        >
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</header>
