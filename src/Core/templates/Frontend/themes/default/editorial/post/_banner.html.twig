{# Post banner — rendered above the article when the translation configures one.
   `banner` comes from BannerViewBuilder and is null when disabled or empty, so
   the caller guards on it rather than this file second-guessing.

   Items lay out on the shared 48-column grid (`.aurora-grid`, see
   css/base/aurora-grid.css). Each one carries its width as custom properties
   rather than classes: a span is a runtime number, and Tailwind only emits
   classes it can read in the source.

   The height and alignment maps below are written out literally for the same
   reason — a class assembled by concatenation is one Tailwind never sees. #}

{% set heights = {
    sm: 'min-h-48',
    md: 'min-h-72',
    lg: 'min-h-[32rem]',
    full: 'min-h-screen',
} %}

{% set alignments = {
    start: 'text-left items-start',
    center: 'text-center items-center',
    end: 'text-right items-end',
} %}

{# Contained sits in the article column, rounded and spaced like a card.
   Full spans the viewport flush under the top bar, so it drops the rounding
   and the margin — a corner radius against the window edge reads as a
   mistake, and the gap it would leave is the thing being removed. Inner
   padding grows to keep the text off the window edge. #}
{% set isFull = banner.width == 'full' %}

<header
    {# flex column, so the inner grid can claim the leftover height. `h-full`
       on it would not: the header's own height is auto, and a percentage
       height against min-height resolves to nothing. #}
    class="relative isolate flex flex-col overflow-hidden not-prose {{ heights[banner.height] }} {{ isFull ? 'mb-8' : 'rounded-xl mb-8' }}"
    {# Already a CSS declaration built from hex-validated parts by
       BannerViewBuilder, so `raw` here is not a hole. #}
    {% if banner.background.fillStyle %}style="{{ banner.background.fillStyle|raw }}"{% endif %}
>
    {% if banner.background.media %}
        <img
            src="{{ banner.background.media.url }}"
            alt=""
            aria-hidden="true"
            class="absolute inset-0 -z-10 h-full w-full object-cover"
            style="object-position: {{ banner.background.media.focalPosition }};"
        >
        {% if banner.background.overlay > 0 %}
            {# Darkens the picture so item text stays readable over it. #}
            <div class="absolute inset-0 -z-10 bg-black" style="opacity: {{ banner.background.overlay / 100 }};"></div>
        {% endif %}
    {% endif %}

    {% if banner.logo %}
        <img src="{{ banner.logo.url }}" alt="{{ banner.logo.alt }}" class="absolute top-6 left-6 z-10 h-10 w-auto">
    {% endif %}

    <div class="aurora-grid flex-1 gap-8 {{ isFull ? 'p-8 sm:p-12 lg:px-16' : 'p-8 sm:p-12' }}">
        {% for item in banner.items %}
            <div style="{{ item.spanStyle|raw }}">
                {% if item.type == 'text' %}
                    <div class="flex h-full flex-col justify-center gap-3 {{ alignments[item.align] }}">
                        {% if item.title %}
                            <p class="text-3xl sm:text-4xl font-bold leading-tight"
                               {% if item.titleColor %}style="color: {{ item.titleColor }};"{% endif %}
                            >{{ item.title }}</p>
                        {% endif %}
                        {% if item.description %}
                            <p class="text-base sm:text-lg max-w-prose"
                               {% if item.descriptionColor %}style="color: {{ item.descriptionColor }};"{% endif %}
                            >{{ item.description }}</p>
                        {% endif %}
                    </div>
                {% elseif item.type == 'image' and item.media %}
                    <div class="flex h-full items-center justify-center">
                        <img
                            src="{{ item.media.url }}"
                            alt="{{ item.media.alt }}"
                            class="max-h-full w-full rounded-lg object-cover"
                            style="object-position: {{ item.media.focalPosition }};"
                        >
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</header>
