{# Post banner - rendered above the article when the translation configures one.
   `banner` comes from BannerViewBuilder and is null when disabled or empty, so
   the caller guards on it rather than this file second-guessing.

   Items lay out on the shared 48-column grid (`.aurora-grid`, see
   css/base/aurora-grid.css). Each one carries its width as custom properties
   rather than classes: a span is a runtime number, and Tailwind only emits
   classes it can read in the source.

   The height and alignment maps below are written out literally for the same
   reason - a class assembled by concatenation is one Tailwind never sees. #}

{% set heights = {
    sm: 'min-h-48',
    md: 'min-h-72',
    lg: 'min-h-[32rem]',
    full: 'min-h-screen',
    image: '',
} %}

{# Three placements:
   - contained    - the banner sits in the article column, rounded like a card
   - full_aligned - background spans the viewport, content keeps the page's
                    own left edge, so the title lines up with the text below
   - full         - background and content both span, edge to edge

   The two full modes drop the rounding: a corner radius against the window
   edge reads as a mistake.

   `full_aligned` mirrors <main>'s own box - max-w-7xl, centred, px-4 - rather
   than guessing a value, so the two stay aligned if that ever changes. #}
{% set isFull = banner.width starts with 'full' %}

{# `image`: the banner takes its picture's proportions, the phone
   picture's below `sm` and the tablet picture's from `sm` to `lg`, so a
   picture with words in it is never cropped.
   Falls back to the `lg` minimum when the file has no known size. Both
   ratios travel as custom properties read by classes: an inline
   `aspect-ratio` would outrank the phone's media query. #}
{% set ratioMedia = banner.height == 'image' ? banner.background.media : null %}
{% set ratioMobile = banner.height == 'image' ? banner.background.mobileMedia|default(null) : null %}
{% set hasRatio = ratioMedia and ratioMedia.width|default(0) > 0 and ratioMedia.height|default(0) > 0 %}
{% set hasMobileRatio = ratioMobile and ratioMobile.width|default(0) > 0 and ratioMobile.height|default(0) > 0 %}
{% set ratioTablet = banner.height == 'image' ? banner.background.tabletMedia|default(null) : null %}
{% set hasTabletRatio = ratioTablet and ratioTablet.width|default(0) > 0 and ratioTablet.height|default(0) > 0 %}
{% if banner.height == 'image' and not hasRatio %}{% set heights = heights|merge({image: heights.lg}) %}{% endif %}

{# A carousel when the banner has slides after its own: the banner's first
   slide is the banner itself, as it was before slides existed, and the
   others take turns in the same box. The height is the first slide's - its
   picture's proportions, or the chosen height - and every slide is stacked
   in that one grid cell, so the box is as tall as the tallest of them and
   nothing jumps when they change. #}
{% set extraSlides = banner.slides|default([]) %}
{% set isCarousel = extraSlides is not empty %}
{% set carousel = banner.carousel|default({}) %}
{% set ratioStyle = (hasRatio ? ' --banner-ratio: ' ~ ratioMedia.width ~ ' / ' ~ ratioMedia.height ~ ';' : '')
    ~ (hasMobileRatio ? ' --banner-mobile-ratio: ' ~ ratioMobile.width ~ ' / ' ~ ratioMobile.height ~ ';' : '')
    ~ (hasTabletRatio ? ' --banner-tablet-ratio: ' ~ ratioTablet.width ~ ' / ' ~ ratioTablet.height ~ ';' : '') %}
{# A plain banner is its own slide, so its fill and its accent go on the
   header, as they always have; a carousel's go on each slide. Both are CSS
   declarations built from hex-validated parts by BannerViewBuilder, so `raw`
   below is not a hole. #}
{% set headerStyle = isCarousel
    ? ratioStyle
    : (banner.background.fillStyle ?? '') ~ ' ' ~ (banner.accentStyle ?? '') ~ ratioStyle %}
<header
    {# flex column, so the inner grid can claim the leftover height. `h-full`
       on it would not: the header's own height is auto, and a percentage
       height against min-height resolves to nothing.

       `overflow-clip`, not `overflow-hidden`: both clip the rounded corners,
       but `hidden` makes a scroll container, and a scroll container with an
       aspect-ratio loses its content-based minimum height. The picture's
       ratio then became a maximum, and a title wrapping onto one more line
       between 640 and 1100px was cut off at the bottom. With `clip` the
       ratio stays a floor and the banner grows to fit its words. #}
    class="relative isolate flex flex-col overflow-clip not-prose {{ heights[banner.height] }} {{ isFull ? 'mb-8' : 'rounded-xl mb-8' }}{{ hasRatio ? ' [aspect-ratio:var(--banner-ratio)]' : '' }}{{ hasMobileRatio ? ' max-sm:[aspect-ratio:var(--banner-mobile-ratio)]' : '' }}{{ hasTabletRatio ? ' sm:max-lg:[aspect-ratio:var(--banner-tablet-ratio)]' : '' }}"
    {% if headerStyle|trim %}style="{{ headerStyle|trim|raw }}"{% endif %}
    {% if isCarousel %}
        {# Read by bannerCarousel.js. Without the script the first slide
           stays, and the controls stay hidden. #}
        data-banner-carousel
        data-autoplay="{{ (carousel.autoplay ?? true) ? 'true' : 'false' }}"
        data-interval="{{ carousel.interval|default(7) }}"
        data-pause-on-hover="{{ (carousel.pauseOnHover ?? true) ? 'true' : 'false' }}"
        data-transition="{{ carousel.transition|default('fade') }}"
        role="region"
        aria-roledescription="{{ 'frontend.editorial.banner.carousel.role'|trans }}"
        aria-label="{{ 'frontend.editorial.banner.carousel.label'|trans }}"
    {% endif %}
>
    {% if isCarousel %}
        {% set allSlides = [banner]|merge(extraSlides) %}
        <div class="aurora-banner-track flex-1" data-banner-track>
            {% for slide in allSlides %}
                <div
                    class="aurora-banner-slide relative isolate flex flex-col"
                    data-banner-slide
                    {% if loop.first %}data-active{% else %}aria-hidden="true" inert{% endif %}
                    role="group"
                    aria-roledescription="{{ 'frontend.editorial.banner.carousel.slide_role'|trans }}"
                    aria-label="{{ 'frontend.editorial.banner.carousel.slide'|trans({'%index%': loop.index, '%count%': allSlides|length}) }}"
                    {% set slideStyle = (slide.background.fillStyle ?? '') ~ ' ' ~ (slide.accentStyle ?? '') %}
                    {% if slideStyle|trim %}style="{{ slideStyle|trim|raw }}"{% endif %}
                >
                    {{ include('Frontend/themes/default/editorial/post/_banner_slide.html.twig', {slide: slide, banner: banner}) }}
                </div>
            {% endfor %}
        </div>

        {% if (carousel.arrows ?? true) %}
            {# Beside the words rather than over them: out on the edges, and
               from `sm` only - a phone swipes, and on its width an arrow
               would sit on the title. #}
            <button type="button" class="aurora-banner-arrow" data-banner-prev data-side="start" hidden aria-label="{{ 'frontend.editorial.banner.carousel.previous'|trans }}">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class="aurora-banner-arrow" data-banner-next data-side="end" hidden aria-label="{{ 'frontend.editorial.banner.carousel.next'|trans }}">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </button>
        {% endif %}

        {# The dots, and the pause button when the slides turn by themselves:
           a banner that moves on its own for longer than five seconds owes
           its reader a way to stop it (WCAG 2.2.2), and stopping under the
           pointer does nothing for a keyboard or a finger. #}
        {% if (carousel.dots ?? true) or (carousel.autoplay ?? true) %}
            <div class="aurora-banner-dots" data-banner-controls hidden>
                {% if (carousel.autoplay ?? true) %}
                    <button
                        type="button"
                        class="aurora-banner-pause"
                        data-banner-pause
                        data-label-pause="{{ 'frontend.editorial.banner.carousel.pause'|trans }}"
                        data-label-play="{{ 'frontend.editorial.banner.carousel.play'|trans }}"
                        aria-label="{{ 'frontend.editorial.banner.carousel.pause'|trans }}"
                    >
                        <svg data-icon-pause viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
                        <svg data-icon-play viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" hidden><path d="M8 5.5v13l10-6.5z"/></svg>
                    </button>
                {% endif %}
                {% if (carousel.dots ?? true) %}
                    {% for slide in allSlides %}
                        <button
                            type="button"
                            class="aurora-banner-dot"
                            data-banner-dot="{{ loop.index0 }}"
                            {% if loop.first %}aria-current="true"{% endif %}
                            aria-label="{{ 'frontend.editorial.banner.carousel.go_to'|trans({'%index%': loop.index, '%count%': allSlides|length}) }}"
                        ></button>
                    {% endfor %}
                {% endif %}
            </div>
        {% endif %}
    {% else %}
        {{ include('Frontend/themes/default/editorial/post/_banner_slide.html.twig', {slide: banner, banner: banner}) }}
    {% endif %}

    {% if banner.logo %}
        <img src="{{ banner.logo.url }}" alt="{{ banner.logo.alt }}" class="absolute top-6 left-6 z-10 h-10 w-auto">
    {% endif %}
</header>
