{# What moved lately, newest first, publications and releases mixed. A line
   down the side and a dot per entry: the shape of a timeline, which is what
   a reader expects of "latest activity". #}
<ol class="not-prose relative m-0 list-none space-y-5 border-l border-line p-0 pl-6">
    {% for entry in zone.activityFeed %}
        <li class="relative">
            <span class="absolute -left-[1.84rem] top-1.5 h-3 w-3 rounded-full border-2 border-surface {{ entry.kind == 'release' ? 'bg-accent-300' : 'bg-accent-500' }}" aria-hidden="true"></span>
            <p class="m-0 text-xs uppercase tracking-wide text-muted">{{ entry.dateLabel }} · {{ ('frontend.editorial.grid.activity.' ~ entry.kind)|trans }}</p>
            <a href="{{ entry.url }}" class="mt-0.5 block text-base font-semibold text-primary no-underline hover:text-highlight"{% if entry.kind == 'release' %} rel="noopener"{% endif %}>{{ entry.title }}</a>
            {% if entry.detail %}<p class="m-0 mt-0.5 line-clamp-2 text-sm text-secondary">{{ entry.detail }}</p>{% endif %}
        </li>
    {% endfor %}
</ol>
