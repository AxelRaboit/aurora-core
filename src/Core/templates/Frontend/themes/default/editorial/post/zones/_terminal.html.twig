{# A terminal window. A line that starts with `$ ` is a command, the rest is
   what it printed. All of it is in the markup from the start, readable and
   copyable; terminal.js hides it and types it back in once the window
   scrolls into view, unless the reader asked for less motion. #}
<div class="not-prose overflow-hidden rounded-xl border border-white/10 bg-[#0d1117] shadow-lg" data-terminal>
    <div class="flex items-center gap-1.5 border-b border-white/10 px-4 py-2.5" aria-hidden="true">
        <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
        <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
        <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
    </div>
    <pre class="m-0 overflow-x-auto p-4 font-mono text-sm leading-relaxed text-[#c9d1d9]"><code>{% for line in zone.code|split('\n') %}{% if line starts with '$ ' %}<span class="block" data-terminal-command><span class="select-none text-[#3fb950]">$ </span><span data-terminal-type>{{ line|slice(2) }}</span></span>{% else %}<span class="block text-[#8b949e]" data-terminal-output>{{ line ?: ' ' }}</span>{% endif %}{% endfor %}</code></pre>
</div>
