{% extends 'Frontend/themes/default/layout.html.twig' %}

{% block seo_define %}{% do seo({title: term.name, description: term.description}) %}{% endblock %}

{% block body %}
    <p class="text-xs uppercase tracking-wide text-muted">{{ taxonomy.label }}</p>
    <h1 class="text-2xl font-semibold text-primary mb-2">{{ term.name }}</h1>
    {% if term.description %}
        <p class="text-secondary mb-6">{{ term.description }}</p>
    {% endif %}
    {{ include('Frontend/themes/default/editorial/_posts.html.twig') }}
{% endblock %}
