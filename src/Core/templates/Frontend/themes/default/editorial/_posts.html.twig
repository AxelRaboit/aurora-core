{# Shared listing markup. Rendered server-side rather than mounted as a Vue
   app: a public listing has nothing interactive about it, and HTML that is
   already there is what a search engine - and a reader whose JavaScript did
   not load - actually gets.

   The card itself lives in `_post_card.html.twig`, shared with the `post`
   zone of a content grid. #}
{% if posts is empty %}
    <p class="text-secondary">{{ 'frontend.editorial.no_posts'|trans }}</p>
{% else %}
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for post in posts %}
            {{ include('Frontend/themes/default/editorial/_post_card.html.twig', {post: post, locale: locale}) }}
        {% endfor %}
    </div>

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 mt-8" aria-label="{{ 'frontend.editorial.pagination'|trans }}">
            {% for pageNumber in 1..totalPages %}
                <a
                    href="?page={{ pageNumber }}"
                    class="px-3 py-1.5 rounded-lg text-sm {{ pageNumber == page ? 'bg-surface border border-line text-primary font-semibold' : 'text-secondary hover:text-primary' }}"
                >{{ pageNumber }}</a>
            {% endfor %}
        </nav>
    {% endif %}
{% endif %}
