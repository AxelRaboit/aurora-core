{% extends 'Frontend/themes/default/layout.html.twig' %}

{% block seo_define %}
    {% do seo({
        title: formTitle,
        description: formDescription,
        type: 'website',
    }) %}
{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto space-y-6">
    <header class="space-y-2">
        <h1 class="text-2xl font-semibold text-primary">{{ formTitle }}</h1>
        {% if formDescription %}
            <p class="text-secondary">{{ formDescription }}</p>
        {% endif %}
    </header>

    <div {{ vue_component('editorial/frontend/FormRender', {
        form: formData,
        submitPath: submitPath,
    }) }}></div>
</div>
{% endblock %}
