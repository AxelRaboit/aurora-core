{# The active theme's settings that are applied as CSS when the page loads. #}
{# Inject in <head> so utility classes like bg-accent-600 / text-accent-400 pick it up app-wide. #}
{# The file keeps its original name: it is included by a dozen templates here
   and by the projects that consume Aurora, and renaming it would break them
   silently. It is the theme's injection point, the colour is only one part of
   it. #}
<style>{{ themeStyles.primaryColorCss()|raw }}</style>
{# The theme's font. Nothing is emitted as long as it stays on the default
   (Sora), which `theme.css` already sets. #}
{% set fontCss = themeStyles.fontFamilyCss() %}
{% if fontCss %}
    <style>{{ fontCss|raw }}</style>
{% endif %}
