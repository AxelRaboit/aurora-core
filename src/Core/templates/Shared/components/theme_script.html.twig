<script nonce="{{ csp_nonce() }}">
    (function () {
        const storedTheme = localStorage.getItem('aurora-theme');
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
            {% if colorScheme is defined and colorScheme %}
            document.documentElement.style.colorScheme = 'dark';
            {% endif %}
        }
        {% if sidemenu is defined and sidemenu %}
        {# Collapsed is not read here any more: it lives on the user and the
           layout renders it. Only the width is still the browser's, because a
           pixel count describes the screen it was dragged on. #}
        const storedWidth = localStorage.getItem('aurora-sidemenu-width');
        if (storedWidth) {
            const parsedWidth = parseInt(storedWidth, 10);
            if (Number.isFinite(parsedWidth)) {
                document.documentElement.style.setProperty('--sidemenu-width', parsedWidth + 'px');
            }
        }
        {% endif %}
    })();
</script>
{# Les gris du clair et du sombre choisis dans Réglages > Apparence. Posés ici
   parce que chaque gabarit qui a le clair/sombre inclut ce fichier, et le site
   public non. La balise reste même vide : l'onglet Apparence la remplit
   après un enregistrement, sans recharger la page. #}
