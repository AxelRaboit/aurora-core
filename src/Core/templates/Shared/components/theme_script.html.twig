{# Light unless the reader chose dark: the suite opens in its light theme
   whatever the computer's own setting, and the button in the top bar is
   how anyone moves to dark (Axel, 10/10/2026). It followed the system
   before, so a Mac set to dark opened every first visit in dark. #}
<script nonce="{{ csp_nonce() }}">
    (function () {
        let storedTheme = null;
        try {
            storedTheme = localStorage.getItem('aurora-theme');
        } catch (error) {
            // Storage refused (private window): the light theme stands.
        }
        if ('dark' === storedTheme) {
            document.documentElement.classList.add('dark');
            {% if colorScheme is defined and colorScheme %}
            document.documentElement.style.colorScheme = 'dark';
            {% endif %}
        }
        {% if sidemenu is defined and sidemenu %}
        {# Collapsed is not read here any more: it lives on the user and the
           layout renders it. Only the width is still the browser's, because a
           pixel count describes the screen it was dragged on. #}
        const storedWidth = localStorage.getItem('aurora-sidemenu-width');
        if (storedWidth) {
            const parsedWidth = parseInt(storedWidth, 10);
            if (Number.isFinite(parsedWidth)) {
                document.documentElement.style.setProperty('--sidemenu-width', parsedWidth + 'px');
            }
        }
        {% endif %}
    })();
</script>
{# The light and dark greys chosen in Réglages > Apparence. Set here because
   every template with light/dark includes this file, and the public site does
   not. The tag stays even when empty: the Apparence tab fills it after a
   save, without reloading the page. #}
<style id="aurora-suite-palette">{{ app_suite_palette_css()|raw }}</style>
