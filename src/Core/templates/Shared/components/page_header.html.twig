<header class="bg-surface border-b border-line h-16 flex items-center lg:sticky lg:top-0 lg:z-20 shrink-0">
    {# The one control that folds the side menu, at the top left of the page —
       not inside the menu it hides. A button that lives in the thing it hides
       needs a second copy somewhere to bring it back, which is what Aurora had.

       `hidden lg:flex`: below the large breakpoint the menu is a drawer with
       its own button in the mobile bar, and folding a drawer means nothing. #}
    <div class="hidden lg:flex items-center gap-1 pl-3">
        <div {{ vue_component('core/backend/sidemenu/AppSidemenuToggle', {
            collapsedPath: path('backend_general_profile_sidemenu_collapsed'),
        }) }}></div>
        {# Back, forward and reload — browser chrome brought into the page,
           beside the control that folds the menu. Desktop only, like the
           toggle: a phone has its own back gesture and no room to spare. #}
        <div class="border-l border-line pl-1">
            <div {{ vue_component('core/backend/sidemenu/AppTopbarNav') }}></div>
        </div>
    </div>
    <div class="px-4 sm:px-6 lg:px-8 w-full min-w-0">
        {% if crumbs is defined and crumbs %}
            <nav class="flex items-center gap-2 text-sm min-w-0">
                {% for crumb in crumbs %}
                    {% set isVisible = loop.index >= (crumbs|length - 1) %}
                    {% if not loop.first %}
                        <span class="text-muted select-none shrink-0 {% if not isVisible %}hidden sm:inline{% endif %}">/</span>
                    {% endif %}
                    <span class="{% if not isVisible %}hidden sm:inline{% endif %} min-w-0">
                        {% if crumb.href is defined and crumb.href %}
                            <a href="{{ crumb.href }}" class="text-secondary hover:text-primary transition-colors truncate block">{{ crumb.label }}</a>
                        {% else %}
                            <span class="text-primary font-medium truncate block">{{ crumb.label }}</span>
                        {% endif %}
                    </span>
                {% endfor %}
            </nav>
        {% else %}
            <h2 class="text-xl font-semibold leading-tight text-primary">{{ title }}</h2>
        {% endif %}
    </div>

    {# Search and notifications, at the far right. They used to sit in the side
       menu above the nav filter, which put two controls that have nothing to do
       with navigation inside the thing that navigates — and hid them both
       whenever the menu was folded to icons. #}
    {# `hidden lg:flex`, like the controls on the left: below the large
       breakpoint the mobile bar carries its own search button, and two of them
       on one screen is one too many. #}
    <div class="hidden lg:flex items-center gap-1 pr-3 sm:pr-6 lg:pr-8 shrink-0">
        <div {{ vue_component('core/backend/sidemenu/AppTopbarActions', {
            notificationsListPath: path('backend_notifications_list'),
            notificationsMarkReadPath: path_template('backend_notifications_mark_read', {id: '__id__'}),
            notificationsMarkAllReadPath: path('backend_notifications_mark_all_read'),
            notificationsDeletePath: path_template('backend_notifications_delete', {id: '__id__'}),
            notificationsDeleteAllPath: path('backend_notifications_delete_all'),
        }) }}></div>
    </div>
</header>
