{% set features = features ?? [
    {icon: 'file-text', label: 'suite.auth.hero.feature_1'},
    {icon: 'sliders', label: 'suite.auth.hero.feature_2'},
    {icon: 'image', label: 'suite.auth.hero.feature_3'},
    {icon: 'zap', label: 'suite.auth.hero.feature_4'},
] %}
<h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-primary leading-tight mb-4">
    {{ 'suite.auth.hero.heading'|trans }}<br>
    <span class="text-accent-500">{{ 'suite.auth.hero.heading_accent'|trans({'{siteName}': siteName}) }}</span>
</h1>
<p class="text-secondary text-base leading-relaxed lg:mb-8">{{ 'suite.auth.hero.description'|trans }}</p>
{# On a phone, the title and the sentence alone: they say where one is
   without pushing the form down, which the four selling points pushed below
   the fold. They come back next to the form from `lg` on. #}
<ul class="hidden space-y-3 lg:block">
    {% for feature in features %}
        <li class="flex items-center gap-3 text-secondary text-sm">
            {{ include('@Shared/components/icon.html.twig', {name: feature.icon, class: 'w-4 h-4 text-accent-500 shrink-0', size: 16}) }}
            {{ feature.label|trans }}
        </li>
    {% endfor %}
</ul>
