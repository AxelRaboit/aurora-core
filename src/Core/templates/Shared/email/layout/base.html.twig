{% apply inline_css(source('@styles/email.css')) %}
{% set logoInitial = (siteName|default('A')|trim|first|upper) %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ siteName }}{% endblock %}</title>
</head>
<body>

<table class="wrapper" role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr>
<td align="center">

    <table class="content" role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">

        <tr>
            <td class="header">
                <table cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin: 0 auto;">
                    <tr>
                        <td align="center" style="padding-bottom: 8px;">
                            <!--[if mso]>
                            <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" style="height:48px;width:48px;" arcsize="22%" fillcolor="#059669" stroke="f">
                                <v:textbox style="mso-fit-shape-to-text:false;" inset="0,0,0,0">
                                    <center style="color:#ffffff;font-family:'Segoe UI',sans-serif;font-size:26px;font-weight:700;">{{ logoInitial }}</center>
                                </v:textbox>
                            </v:roundrect>
                            <![endif]-->
                            <!--[if !mso]><!-->
                            <div style="width:48px;height:48px;background:linear-gradient(135deg,#10b981,#059669);background-color:#059669;border-radius:11px;margin:0 auto;display:table-cell;text-align:center;vertical-align:middle;color:#ffffff;font-family:'Inter','Segoe UI',sans-serif;font-size:28px;font-weight:700;">{{ logoInitial }}</div>
                            <!--<![endif]-->
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="font-family:'Inter','Segoe UI',sans-serif;font-size:19px;font-weight:700;color:#059669;">
                            {{ siteName }}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <tr>
            <td class="body">
                <table class="inner-body" role="presentation" cellpadding="0" cellspacing="0" border="0" align="center">
                    <tr>
                        <td class="content-cell">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <tr>
            <td>
                <table class="footer" role="presentation" cellpadding="0" cellspacing="0" border="0" align="center">
                    <tr>
                        <td align="center" style="padding: 16px;">
                            <p>© {{ 'now'|date('Y') }} {{ siteName }}</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

    </table>
</td>
</tr>
</table>

</body>
</html>
{% endapply %}
