# IDE
/.idea/
/.vscode/

# macOS
.DS_Store

# pnpm-workspace.yaml is deliberately NOT ignored. `allowBuilds` is a policy
# call about a dependency - identical on every machine - and tracking it is the
# only way clients get it. While ignored it never reached the composer package,
# so any client running `pnpm install` inside vendor/axelraboit/aurora got
# pnpm's unanswered placeholder written back and the build died on
# ERR_PNPM_IGNORED_BUILDS.

# Version (generated at deploy time)
/VERSION

# PHP CS Fixer
.php-cs-fixer.cache

# Twig CS Fixer
.twig-cs-fixer.cache

# Tools vendors - the lock files ARE versioned, on purpose: CI runs
# `composer install` in each tools/ dir, so without a lock it resolves the
# newest release every run and green-locally stops meaning green-in-CI.
/tools/*/vendor/

# Generated translation catalogues (run `pnpm i18n` to rebuild)
/src/Core/assets/locales/generated/

# Claude Code runtime locks
.claude/scheduled_tasks.lock
