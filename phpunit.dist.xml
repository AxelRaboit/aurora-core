<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <!--
        The R2 suite talks to a real Cloudflare bucket. It skips itself when
        the credentials are absent, which covers CI, but a developer who has
        them in `.env.local` would otherwise pay eight seconds of network and a
        handful of billed operations on every single run of the suite.

        So it is opt-in, through `make test-r2`.
    -->
    <groups>
        <exclude>
            <group>r2</group>
        </exclude>
    </groups>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <!-- Pas de bloc `coverage` ici, et c'est le sujet : un `report` déclaré
         dans la configuration est demandé à *chaque* appel de phpunit, donc
         la couverture était collectée et deux rapports écrits pour lancer un
         seul fichier de test. Mesuré sur la suite unitaire : 34 s avec, 14 s
         sans. Elle finissait aussi par épuiser les 512 Mo à l'écriture du
         rapport HTML, ce qui faisait échouer la porte sur autre chose qu'un
         test.

         La couverture se demande donc quand on la veut, par `make coverage`,
         qui allume pcov et nomme ses rapports. -->

    <extensions>
    </extensions>
</phpunit>
